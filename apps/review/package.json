{
  "name": "@verdict-ai/review-app",
  "private": true,
  "version": "0.1.0",
  "description": "서류 검토 웹 서비스 — 자연어 요건으로 업로드한 서류를 Verdict 엔진으로 한 건씩 판정한다.",
  "type": "module",
  "files": [
    "server/dist",
    "web/dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:server": "node --watch server/dist/main.js",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node server/dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@napi-rs/canvas": "^1.1.1",
    "@verdict-ai/api": "workspace:*",
    "@verdict-ai/core": "workspace:*",
    "@verdict-ai/db": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
