{
  "name": "@verdict-ai/review-deploy",
  "private": true,
  "version": "0.1.0",
  "description": "서류 검토 서비스를 Cloudflare Containers에 올리는 앞단 Worker(접근 제어 + 컨테이너 1대).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.165.0"
  }
}
