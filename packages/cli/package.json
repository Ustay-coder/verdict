{
  "name": "@verdict-ai/cli",
  "version": "0.3.2",
  "description": "verdict CLI — evaluate anything from the terminal.",
  "type": "module",
  "bin": {
    "verdict": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@verdict-ai/api": "workspace:*",
    "@verdict-ai/core": "workspace:*",
    "@verdict-ai/mcp": "workspace:*",
    "@verdict-ai/sdk": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@verdict-ai/db": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ustay-coder/verdict.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Ustay-coder/verdict#readme",
  "bugs": {
    "url": "https://github.com/Ustay-coder/verdict/issues"
  },
  "keywords": [
    "evaluation",
    "rubric",
    "decision-model",
    "jev",
    "clef",
    "scoring",
    "llm-judge",
    "mcp"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
