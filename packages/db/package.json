{
  "name": "@verdict/db",
  "version": "0.1.0",
  "description": "Verdict persistence on Drizzle ORM \u2014 Cloudflare D1 (SQLite) now, Postgres next.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply verdict --local",
    "db:migrate:remote": "wrangler d1 migrations apply verdict --remote"
  },
  "dependencies": {
    "@verdict/core": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.11"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}