{
  "name": "@verdict/sdk",
  "version": "0.1.0",
  "description": "Verdict TypeScript SDK — a Resend-style client for the evaluation API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@verdict/core": "workspace:*"
  }
}
