# Decision-model judges (primary) — set the ones you use
TYPESAFE_API_KEY=                 # provider: typesafe (Jev)   VERDICT_TYPESAFE_MODEL=jev-latest
# CLOUDFLARE_ACCOUNT_ID=  CLOUDFLARE_API_TOKEN=   VERDICT_CLOUDFLARE_MODEL=@cf/cloudflare/clef   (provider: cloudflare — Clef / Clef-flash / typesafe/jev)
# OPENROUTER_API_KEY=     VERDICT_OPENROUTER_MODEL=typesafe/jev-1.13                                 (provider: openrouter)
# OPENAI_API_KEY=         VERDICT_OPENAI_DECISIONS_MODEL=gpt-6-luna                                   (provider: openai — Decisions API)
# SYSTEMONE_BASE_URL=     SYSTEMONE_API_KEY=                                                         (provider: systemone — any /v1/systemone endpoint)

# Generative LLM judge (optional, for rationales)
ANTHROPIC_API_KEY=
# VERDICT_ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=            OPENAI_BASE_URL=https://api.openai.com/v1   OPENAI_MODEL=gpt-4o-mini
# CLOUDFLARE_ACCOUNT_ID=     CLOUDFLARE_API_TOKEN=                       CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# VERDICT_HTTP_JUDGE_URL=    VERDICT_HTTP_JUDGE_KEY=

# API
# VERDICT_DATABASE=./verdict.sqlite        # Drizzle on SQLite (same schema/migrations as D1); DB-managed API keys
# VERDICT_DATABASE=postgres://user:password@localhost:5432/verdict # Postgres instead of SQLite
# DATABASE_URL=postgres://user:password@localhost:5432/verdict     # Postgres migration command
# VERDICT_ADMIN_KEY=                       # enables /v1/admin/keys
# VERDICT_API_KEYS=sk_live_abc:acme,sk_live_def:globex   # bootstrap keys
# VERDICT_DATA_DIR=./data                  # JSON-file store instead of a database
# CLOUDFLARE_D1_DATABASE_ID=               # for drizzle-kit push/studio against D1 (with CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN)
# VERDICT_WEBHOOK_SECRET=
# VERDICT_ALLOW_LOCAL_FILES=0
# PORT=8787

# CLI / MCP in remote mode
# VERDICT_API_URL=http://localhost:8787
# VERDICT_API_KEY=sk_live_abc
