{
  "name": "verdict-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Verdict \u2014 the evaluation engine API. Customizable rubrics, pluggable judges (Decision AI / human / benchmark), customizable aggregation. API, CLI and MCP.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "dev:api": "pnpm --filter @verdict/api run dev",
    "verdict": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}