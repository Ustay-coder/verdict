[107.9377, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;167m\u001b[48;5;52m \u001b[10G\u001b[38;5;231mtended.    \u001b[22G \u001b[24G \u001b[26G  \u001b[29G \u001b[31G  \u001b[34G \u001b[36G  \u001b[39G \u001b[41G  \u001b[44G \u001b[46G  \u001b[49G \u001b[51G  \u001b[54G \u001b[56G  \u001b[59G \u001b[61G  \u001b[64G \u001b[66G   \u001b[70G  \u001b[73G     \u001b[79G \u001b[81G        \u001b[90G    \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 5 +\u001b[38;5;231mThe scores: 0 \u2192 10 \u2192 20 \u2192 23 \u2192 33 \u2192 34 \u2192 49 \u2192 58 \u2192 71 \u2192 93, in about 8 minutes, unat\r\u001b[6C\u001b[1B\u001b[38;5;77m \u001b[10G\u001b[38;5;231mtended.\u001b[48;5;28m Two rounds barely moved because the fix was partial.\u001b[48;5;22m  \u001b[73G     \u001b[79G \u001b[81G        \u001b[90G    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m7\u001b[10G\u001b[22m#DevTools #buildinpublic\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mNext\u001b[8Gfix:\u001b[13Gend\u001b[17Gon\u001b[20Ga\u001b[22Gquestion\u001b[31Greaders\u001b[39Gcan\u001b[43Ganswer\u001b[50Gfrom\u001b[55Gtheir\u001b[61Gown\u001b[65Gwork.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(post.md)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m2\u001b[22m lines\r\u001b[1B     \u001b[38;5;231m\u001b[2m 4 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m5\u001b[10G\u001b[22mThe scores: 0 \u2192 10 \u2192 20 \u2192 23 \u2192 33 \u2192 34 \u2192 49 \u2192 58 \u2192 71 \u2192 93, in about 8 minutes, unat\r\u001b[6C\u001b[1B\u001b[2m \u001b[10G\u001b[22mtended. Two\u001b[22Grounds\u001b[29Gbarely\u001b[36Gmoved because the\u001b[54Gfix was partial.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m6\u001