[122.1123, "o", "\u001b[?25l\u001b[H\u001b[3G\u2502\u001b[5G9     \u2502 80    \u2502 close  \u2502 \u001b[1mlimits:\u001b[22m added \"Two rounds barely moved because the fix was      \u001b[97G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[6G     \u2502       \u2502        \u2502 partial.\"                                                       \u001b[97G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5G10   \u001b[11G\u2502\u001b[13G\u001b[1m88\u001b[19G\u001b[22m\u2502\u001b[21G\u001b[1mpost \u001b[28G\u001b[22m\u2502\u001b[30G\u001b[1mquestion:\u001b[40G\u001b[22madded\u001b[46Ga\u001b[48Gclosing\u001b[56Gquestion:\u001b[66G\"What\u001b[72Gcheck\u001b[78Gwould\u001b[84Gyou\u001b[88Gadd\u001b[97G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[6G     \u2502       \u2502 \u001b[1mit\u001b[22m     \u2502 before\u001b[37Gyou\u001b[41Glet\u001b[45Gan\u001b[48Gagent\u001b[54Gship\u001b[59Gyour\u001b[64Glanding\u001b[72Gpage?\"\u001b[97G\u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFinal post.md\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mAn AI one-shot landing page scored 0. Eight minutes later it scored 93.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[38;5;153mClaude Code took an AI one-shot landing page for Tideline (a fictional product) and rebuilt it one\r\u001b[2C\u001b[1Bcheck at a time, scored by Verdict, an evaluation engine that scores work against a rubric.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mThe scores: 0 \u2192 10 \u2192 20 \u2192 23 \u2192 33 \u2192 34 \u2192 49 \u2192 58 \u2192 71 \u2192 93, in about 8 minutes, unattended. Two \r\u001b[2C\u001b[1Brounds barely moved because the fix was partial.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mWhat check would you add before you let an agent ship your landing page?\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153m#DevTools #buildinpublic\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  Things to know\u001b[18Gbefore\u001b[25Gposting:\r\u001b[2B \u001b[3G- \u001b[1mWeakest criterion:\u001b[22m \"clear\" (one idea, plain words) scored\u001b[63G2.76\u001b[68Gout\u001b[72Gof\u001b[75G5\u001b[77Gand\u001b[81Gfell\u001b[86Gslightly\u001b[95Gas\u001b[98GI\r\u001b[1B    added text. The likely reason is that the post now packs in several required points. All\u001b[94Geight\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[122.2422, "o", "\u001b[?25l\u001b[H\u001b[3G\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[4C\u001b[1B10\u001b[13G\u001b[1m88\u001b[21Gpost \u001b[30Gquestion:\u001b[40G\u001b[22madded\u001b[46Ga\u001b[48Gclosing\u001b[56Gquestion:\u001b[66G\"What\u001b[72Gcheck\u001b[78Gwould\u001b[84Gyou\u001b[88Gadd\r\u001b[2C\u001b[1B\u2502       \u2502       \u2502 \u001b[1mit\u001b[22m     \u2502 before you let an agent ship your landing page?\"                   \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFinal post.md\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;5;153mAn AI one-shot landing page scored 0. Eight minutes later it scored 93.\r\u001b[2C\u001b[2BClaude Code took an AI\u001b[26Gone-shot landing page for Tideline\u001b[61G(a\u001b[64Gfictional product) and rebuilt it one\r\u001b[2C\u001b[1Bcheck at a time, scored by Verdict, an evaluation engine that scores work against a rubric.\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mT\u001b[6G scores: 0 \u2192 10 \u2192 20\u001b[27G\u2192 23 \u2192 33 \u2192\u001b[39G34\u001b[42G\u2192 49 \u2192 58 \u2192 71 \u2192 93, in about\u001b[72G8 minutes, un\u001b[86Gttended\u001b[94G Two \r\u001b[2C\u001b[1Brounds barely moved because the fix was partial.\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mWhat check would you add b\u001b[30Gfor\u001b[35Gyou\u001b[39Glet\u001b[43Gan agent ship your landing page?\r\u001b[2C\u001b[2B#DevTools #bui\u001b[19Ginp\u001b[23Gblic\u001b[39m\u001b[K\r\u001b[2C\u001b[2BThings to know before posting:\r\u001b[2C\u001b[2B- \u001b[1mWeakest criterion:\u001b[22m \"clear\" (one\u001b[37Gidea,\u001b[43Gplain\u001b[49Gwords)\u001b[56Gscored\u001b[63G2.76\u001b[68Gout\u001b[72Gof\u001b[75G5\u001b[77Gand\u001b[81Gfell\u001b[86Gslightly\u001b[95Gas\u001b[98GI\r\u001b[4C\u001b[1Badded\u001b[11Gtext.\u001b[17GThe\u001b[21Glikely\u001b[28Greason\u001b[35Gis\u001b[38Gthat\u001b[43Gthe\u001b[47Gpost\u001b[52Gnow\u001b[56Gpacks\u001b[62Gin\u001b[65Gseveral\u001b[73Grequired\u001b[82Gpoints.\u001b[90GAll\u001b[94Geight\r\u001b[2C\u001b[1B \u001b[5Gchecks pass and the gate passes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
