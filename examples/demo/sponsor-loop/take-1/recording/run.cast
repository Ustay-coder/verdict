[46.3128, "o", "\u001b[?25l\u001b[H\r\u001b[13B \u001b[3G\u001b[38;5;246mRead \u001b[1m3\u001b[22m files, called verdict \u001b[1m2\u001b[22m times \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mThe\u001b[7Gevaluation\u001b[18Gflagged\u001b[26Gone\u001b[30Gline\u001b[35Gas\u001b[38Gunsafe:\u001b[46Ga\u001b[48Gpromise\u001b[56Gof\u001b[59Gguaranteed\u001b[70Gcredit-line\u001b[82Gapproval\u001b[91Gat\u001b[94G[1:02],\r\u001b[2C\u001b[1Bwhich\u001b[9Gbreaks\u001b[16Gthe\u001b[20Gbrief's\u001b[28Gmust-not\u001b[37Glist.\u001b[43GI'm\u001b[47Gremoving\u001b[56Gthat\u001b[61Gline\u001b[66Gand\u001b[70Gleaving\u001b[78Gthe\u001b[82Grest\u001b[87Gof\u001b[90Gthe\u001b[94Gscript\r\u001b[2C\u001b[1Balone.\r\u001b[13C\u001b[7B\u001b[38;5;246m4\u001b[21G2\u001b[23G0\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
