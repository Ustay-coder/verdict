[57.9538, "o", "\u001b[?25l\u001b[H\r\u001b[13B \u001b[3G\u001b[38;5;246mRead \u001b[1m3\u001b[22m files, called verdict \u001b[1m2\u001b[22m times \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m1\ud68c\ucc28\ub294\u001b[11G\uc9c8\ubcd1\u001b[16G\uac8c\uc774\ud2b8\uc5d0\u001b[25G\uac78\ub824\u001b[30G0\uc810\uc774\ub77c,\u001b[39G\uba3c\uc800\u001b[44G24\ud589\uc758\u001b[51G\ub2f9\ub1e8\u001b[56G\uce58\ub8cc\u001b[61G\ubb38\uad6c\ub97c\u001b[68G\uc758\uc57d\ud488\uc774\u001b[77G\uc544\ub2c8\ub77c\ub294\u001b[86G\uc548\ub0b4\ub85c\r\u001b[2C\u001b[1B\uace0\uce58\uaca0\uc2b5\ub2c8\ub2e4.\r\u001b[23C\u001b[7B\u001b[38;5;246m4\u001b[26G4\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
