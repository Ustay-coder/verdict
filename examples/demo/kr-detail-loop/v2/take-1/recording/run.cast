[68.4515, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\uac8c\uc774\ud2b8\ub294 \ud1b5\uacfc\ud588\uc9c0\ub9cc\u001b[23G\uc900\uc218\u001b[28G\ud655\ub960\uc774\u001b[35G58%\ub85c\u001b[41G\uc544\uc2ac\uc544\uc2ac\ud569\ub2c8\ub2e4.\u001b[57G\ub2e4\uc74c\uc740\u001b[64G\uc804\ubb38\uac00\u001b[71G\ucd94\ucc9c(no_endorsement)\uc744\r\u001b[2C\u001b[1B\uace0\uce69\ub2c8\ub2e4.\u001b[13G\uc57d\uc0ac\u001b[18G\ucd94\ucc9c\u001b[23G\uc139\uc158\uc744\u001b[30G\uc0ad\uc81c\ud569\ub2c8\ub2e4.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mRemoved\u001b[14G\u001b[1m3\u001b[16G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m  9 \u001b[22m \uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c(\ucf54\ub85c\uc194\uc0b0 1.3mg)\ub85c \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4.\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 10 \u001b[22m \uba39\uae30\ub9cc \ud558\uba74 \ud608\ub2f9\uc774 \ub69d \ub5a8\uc5b4\uc9c0\uace0, \ud6a8\uacfc\ub294 100% \ubcf4\uc7a5\ud569\ub2c8\ub2e4.\r\u001b[6C\u001b[1B\u001b[2m11\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 12 -\u001b[38;5;231m## \uc57d\uc0ac\uac00 \uba3c\uc800 \uad8c\ud569\ub2c8\ub2e4                                                            \r\u001b[5C\u001b[1B\u001b[38;5;167m 13 -\u001b[38;5;231m\"\ud608\ub2f9\uc774 \uac71\uc815\ub418\ub294 \ubd84\ub4e4\uaed8 \uc57d\uad6d\uc5d0\uc11c\ub3c4 \uac00\uc7a5 \uba3c\uc800 \uad8c\ud558\ub294 \uc81c\ud488\uc785\ub2c8\ub2e4.\" (\ud604\uc9c1 \uc57d\uc0ac \uae40OO)  \r\u001b[7C\u001b[1B\u001b[38;5;167m4\u001b[11G\u001b[38;5;231m  \u001b[14G      \u001b[21G    \u001b[26G        \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 12 \u001b[22m ## \ud558\ub8e8 \ud55c \uc54c, \uc2dd\uc0ac \uc804\uc5d0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 13 \u001b[22m 1\uc77c 1\ud68c 1\uc815. \ubb3c\uacfc \ud568\uaed8 \uc2dd\uc0ac 30\ubd84 \uc804\uc5d0 \ub4dc\uc138\uc694.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m4\u001b[11G\u001b[22m\uc791\uc740 \uc815\uc81c\ub77c \uc0bc\ud0a4\uae30 \ud3b8\ud558\uace0, \ud55c \ud1b5\uc73c\ub85c 30\uc77c\uc744 \ucc59\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mNext: \uc21c\uc704\u00b7\uc778\uc99d \uacfc\uc7a5(no_rank_hype).\u001b[39G3\ud589\uc744\u001b[45G\uc0ac\uc2e4\u001b[50G\uadf8\ub300\ub85c\u001b[57G\ubc14\uafc9\ub2c8\ub2e4.\u001b[30;1H\u001b[28;3H\u001b[?25h"]
