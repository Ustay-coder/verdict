[93.8698, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m 2 \u001b[22m \r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 3 \u001b[22m \uc2dd\uc57d\ucc98 \uace0\uc2dc\ud615 \uae30\ub2a5\uc131 \uc6d0\ub8cc \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c\r\u001b[5C\u001b[1B\u001b[2m 4 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m 7 \u001b[22m \r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m ## \uc65c \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c\uc778\uac00\uc694?\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m  9 \u001b[22m \uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c(\ucf54\ub85c\uc194\uc0b0 1.3mg)\ub85c \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4.\r\u001b[1B\u001b[39m     \u001b[38;5;167m\u001b[48;5;52m 10 -\u001b[38;5;231m\uba39\uae30\ub9cc \ud558\uba74 \ud608\ub2f9\uc774 \ub69d \ub5a8\uc5b4\uc9c0\uace0, \ud6a8\uacfc\ub294 100% \ubcf4\uc7a5\ud569\ub2c8\ub2e4.                            \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 10 +\u001b[38;5;231m\ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c\uc740 \uc2dd\ud6c4 \ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.                      \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m11\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m12\u001b[11G\u001b[22m## \ud558\ub8e8 \ud55c \uc54c, \uc2dd\uc0ac \uc804\uc5d0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 13 \u001b[22m 1\uc77c 1\ud68c 1\uc815. \ubb3c\uacfc \ud568\uaed8 \uc2dd\uc0ac 30\ubd84 \uc804\uc5d0 \ub4dc\uc138\uc694.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mNext: \ud544\uc218 \uc815\ubcf4(required_info). \ube60\uc9c4 \ud56d\ubaa9\uc778 '\uac74\uac15\uae30\ub2a5\uc2dd\ud488'\u001b[62G\ud45c\uae30\uc640\u001b[69G\uc12d\ucde8\u001b[74G\uc2dc\u001b[77G\uc8fc\uc758\uc0ac\ud56d\uc744\u001b[88G\ucd94\uac00\ud569\ub2c8\ub2e4.\r\u001b[2B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\r\u001b[2B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mCalling verdict\u2026\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[93.9144, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mNext: \ud544\uc218 \uc815\ubcf4(required_info).\u001b[35G\ube60\uc9c4\u001b[40G\ud56d\ubaa9\uc778\u001b[47G'\uac74\uac15\uae30\ub2a5\uc2dd\ud488'\u001b[62G\ud45c\uae30\uc640\u001b[69G\uc12d\ucde8\u001b[74G\uc2dc\u001b[77G\uc8fc\uc758\uc0ac\ud56d\uc744\u001b[88G\ucd94\uac00\ud569\ub2c8\ub2e4.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m4\u001b[22m lines\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m18\u001b[11G\u001b[22m\"\uc54c\ub78c \ub9de\ucdb0\ub450\uace0 3\uc8fc\uc9f8 \ube60\uc9d0\uc5c6\uc774 \uba39\uace0 \uc788\uc5b4\uc694.\" (52\uc138,\u001b[62G\uc790\uc601\uc5c5)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 19 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 20 \u001b[22m ## \uc774\uac83\ub9cc\uc740 \uaf2d \uc54c\ub824\ub4dc\ub824\uc694\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 21 +\u001b[38;5;231m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \uac74\uac15\uae30\ub2a5\uc2dd\ud488\uc785\ub2c8\ub2e4.                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m 22 +\u001b[38;5;231m\uae30\ub2a5\uc131: \uc2dd\ud6c4 \ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\uc74c                                     \r\u001b[5C\u001b[1B\u001b[38;5;77m 23 +\u001b[38;5;231m\uc12d\ucde8\ub7c9\u00b7\uc12d\ucde8\ubc29\ubc95: 1\uc77c 1\ud68c 1\uc815, \ubb3c\uacfc \ud568\uaed8 \uc2dd\uc0ac 30\ubd84 \uc804\uc5d0 \uc12d\ucde8\ud558\uc138\uc694.                 \r\u001b[5C\u001b[1B\u001b[38;5;77m 24 +\u001b[38;5;231m\uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d: \uc9c8\ud658\uc774 \uc788\uac70\ub098 \uc758\uc57d\ud488\uc744 \ubcf5\uc6a9 \uc911\uc778 \ubd84, \uc784\uc0b0\ubd80\u00b7\uc218\uc720\ubd80\ub294 \uc12d\ucde8 \uc804 \uc804\ubb38\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;231m\uac00\uc640 \uc0c1\ub2f4\ud558\uc138\uc694. \uc774\uc0c1 \uc0ac\ub840\uac00 \ub098\ud0c0\ub098\uba74 \uc12d\ucde8\ub97c \uc911\ub2e8\ud558\uc138\uc694.                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 25 \u001b[22m \uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \uc9c8\ubcd1\uc758 \uc608\ubc29 \ubc0f \uce58\ub8cc\ub97c \uc704\ud55c \uc758\uc57d\ud488\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ubcf5\uc6a9 \uc911\uc778 \uc57d\uc774 \uc788\ub2e4\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m    \u001b[22m \uba74 \uc784\uc758\ub85c \uc911\ub2e8\ud558\uc9c0 \ub9c8\uc138\uc694.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 26 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 27 \u001b[22m ## \uad6c\ub9e4 \uc548\ub0b4\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[93.944, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;246m \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
