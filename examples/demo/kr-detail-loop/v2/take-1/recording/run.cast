[63.8315, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B  \u001b[38;5;246mRead \u001b[1m3\u001b[22m files, called verdict \u001b[1m2\u001b[22m times \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m1\ud68c\ucc28\ub294\u001b[11G\uc9c8\ubcd1\u001b[16G\uac8c\uc774\ud2b8\uc5d0\u001b[25G\uac78\ub824\u001b[30G0\uc810\uc774\ub77c,\u001b[39G\uba3c\uc800\u001b[44G24\ud589\uc758\u001b[51G\ub2f9\ub1e8\u001b[56G\uce58\ub8cc\u001b[61G\ubb38\uad6c\ub97c\u001b[68G\uc758\uc57d\ud488\uc774\u001b[77G\uc544\ub2c8\ub77c\ub294\u001b[86G\uc548\ub0b4\ub85c\r\u001b[2C\u001b[1B\uace0\uce58\uaca0\uc2b5\ub2c8\ub2e4.\u001b[K\r\u001b[2B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 21 \u001b[22m \"\uc54c\ub78c \ub9de\ucdb0\ub450\uace0 3\uc8fc\uc9f8 \ube60\uc9d0\uc5c6\uc774 \uba39\uace0 \uc788\uc5b4\uc694.\" (52\uc138, \uc790\uc601\uc5c5)\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 22 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 23 \u001b[22m ## \uc774\uac83\ub9cc\uc740 \uaf2d \uc54c\ub824\ub4dc\ub824\uc694\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 24 -\u001b[38;5;231m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \ub2f9\ub1e8\ub97c \uce58\ub8cc\ud558\uba70, \uafb8\uc900\ud788 \ub4dc\uc2dc\uba74 \ud608\ub2f9\uc57d\uc744 \ub04a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.         \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 24 +\u001b[38;5;231m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \uc9c8\ubcd1\uc758 \uc608\ubc29 \ubc0f \uce58\ub8cc\ub97c \uc704\ud55c \uc758\uc57d\ud488\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ubcf5\uc6a9 \uc911\uc778 \uc57d\uc774 \uc788\ub2e4 \r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;231m\uba74 \uc784\uc758\ub85c \uc911\ub2e8\ud558\uc9c0 \ub9c8\uc138\uc694.                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 25 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 26 \u001b[22m ## \uad6c\ub9e4 \uc548\ub0b4\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 27 \u001b[22m 29,000\uc6d0 / 30\uc77c\ubd84. \uccab \uad6c\ub9e4 \uc2dc \ubb34\ub8cc\ubc30\uc1a1.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\uac8c\uc774\ud2b8\ub294\u001b[12G\ud1b5\uacfc\ud588\uc9c0\ub9cc\u001b[23G\uc900\uc218\u001b[28G\ud655\ub960\uc774\u001b[35G58%\ub85c\u001b[41G\uc544\uc2ac\uc544\uc2ac\ud569\ub2c8\ub2e4.\u001b[57G\ub2e4\uc74c\uc740\u001b[64G\uc804\ubb38\uac00\u001b[71G\ucd94\ucc9c(no_endorsement)\uc744\r\u001b[1B \u001b[3G\uace0\uce69\ub2c8\ub2e4. \uc57d\uc0ac \ucd94\ucc9c\u001b[23G\uc139\uc158\uc744\u001b[30G\uc0ad\uc81c\ud569\ub2c8\ub2e4.\u001b[30;1H\u001b[28;3H\u001b[?25h"]
