[82.9727, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mNext: \ud6c4\uae30(honest_reviews).\u001b[31G\uc218\uce58\u001b[36G\ubcc0\ud654\u001b[41G\ud6c4\uae30\ub97c\u001b[48G\uc12d\ucde8\u001b[53G\ud3b8\uc758\u001b[58G\ud6c4\uae30\ub85c\u001b[65G\ubc14\uafc9\ub2c8\ub2e4.\r\u001b[2B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m 14 \u001b[22m \uc791\uc740 \uc815\uc81c\ub77c \uc0bc\ud0a4\uae30 \ud3b8\ud558\uace0, \ud55c \ud1b5\uc73c\ub85c 30\uc77c\uc744 \ucc59\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 15 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m6\u001b[11G\u001b[22m## \uafb8\uc900\ud788 \ub4dc\uc2e0 \ubd84\ub4e4\uc758 \uc774\uc57c\uae30\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 17 -\u001b[38;5;231m\"\uacf5\ubcf5\ud608\ub2f9\uc774 130\uc5d0\uc11c 98\ub85c, \ud55c \ub2ec \ub9cc\uc5d0 \uc815\uc0c1 \uc218\uce58\uac00 \ub410\uc5b4\uc694.\" (49\uc138, \ud68c\uc0ac\uc6d0)           \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 17 +\u001b[38;5;231m\"\uc54c\uc57d\uc774 \uc791\uc544\uc11c \uc810\uc2ec \uc804\uc5d0 \ud68c\uc0ac\uc5d0\uc11c\ub3c4 \ubd80\ub2f4 \uc5c6\uc774 \ucc59\uaca8 \uba39\uc5b4\uc694.\" (49\uc138, \ud68c\uc0ac\uc6d0)         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 18 \u001b[22m \"\uc54c\ub78c \ub9de\ucdb0\ub450\uace0 3\uc8fc\uc9f8 \ube60\uc9d0\uc5c6\uc774 \uba39\uace0 \uc788\uc5b4\uc694.\" (52\uc138, \uc790\uc601\uc5c5)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 19 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m20\u001b[11G\u001b[22m## \uc774\uac83\ub9cc\uc740 \uaf2d\u001b[26G\uc54c\ub824\ub4dc\ub824\uc694\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\ub2e4\uc74c\uc740 \ud6a8\uacfc \ud45c\ud604(effect_scope)\uc785\ub2c8\ub2e4.\u001b[41G\uc81c\ubaa9\uc758\u001b[48G\"\ud608\ub2f9\u001b[54G\uac71\uc815,\u001b[60G\uc774\uc81c\u001b[65G\ub05d\"\uacfc\u001b[71G10\ud589\uc758\u001b[78G\"\ud6a8\uacfc\u001b[84G100%\u001b[89G\ubcf4\uc7a5\"\u001b[95G\ubb38\uad6c\ub97c\r\u001b[2C\u001b[1B\uc778\uc815\u001b[8G\ubc94\uc704\uc5d0\u001b[15G\ub9de\uac8c\u001b[20G\uace0\uce58\uaca0\uc2b5\ub2c8\ub2e4.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
