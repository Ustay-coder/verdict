[90.8141, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m 1 -\u001b[38;5;231m# \uc232\uacb0 \ubc14\ub098\ubc14 \uc815 | \ud608\ub2f9 \uac71\uc815, \uc774\uc81c \ub05d                                               \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;77m\u001b[48;5;22m 1 +\u001b[38;5;231m# \uc232\uacb0 \ubc14\ub098\ubc14 \uc815 | \u001b[48;5;28m\uc2dd\uc0ac\u001b[48;5;22m \u001b[48;5;28m\uc804 \ud55c \uc54c\u001b[48;5;22m, \u001b[48;5;28m\uc2dd\ud6c4\u001b[48;5;22m \u001b[48;5;28m\ud608\ub2f9 \uad00\ub9ac\u001b[48;5;22m                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 2 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 3 \u001b[22m \uc2dd\uc57d\ucc98 \uace0\uc2dc\ud615 \uae30\ub2a5\uc131 \uc6d0\ub8cc \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m4\r\u001b[5C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m  7 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m  8 \u001b[22m ## \uc65c \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c\uc778\uac00\uc694?\r\u001b[7C\u001b[1B\u001b[2m9\u001b[11G\u001b[22m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c(\ucf54\ub85c\uc194\uc0b0 1.3mg)\ub85c \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4.\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 10 -\u001b[38;5;231m\uba39\uae30\ub9cc \ud558\uba74 \ud608\ub2f9\uc774 \ub69d \ub5a8\uc5b4\uc9c0\uace0, \ud6a8\uacfc\ub294 100% \ubcf4\uc7a5\ud569\ub2c8\ub2e4.                            \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 10 +\u001b[38;5;231m\ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c\uc740 \uc2dd\ud6c4 \ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 11 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 12 \u001b[22m ## \ud558\ub8e8 \ud55c \uc54c, \uc2dd\uc0ac \uc804\uc5d0\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m3\u001b[11G\u001b[22m1\uc77c 1\ud68c 1\uc815. \ubb3c\uacfc \ud568\uaed8 \uc2dd\uc0ac 30\ubd84 \uc804\uc5d0 \ub4dc\uc138\uc694.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mNext: \ud544\uc218 \uc815\ubcf4(required_info). \ube60\uc9c4 \ud56d\ubaa9\uc778 '\uac74\uac15\uae30\ub2a5\uc2dd\ud488'\u001b[62G\ud45c\uae30\uc640\u001b[69G\uc12d\ucde8\u001b[74G\uc2dc\u001b[77G\uc8fc\uc758\uc0ac\ud56d\uc744\u001b[88G\ucd94\uac00\ud569\ub2c8\ub2e4.\u001b[30;1H\u001b[28;3H\u001b[?25h"]
