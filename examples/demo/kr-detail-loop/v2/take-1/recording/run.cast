[105.5257, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u2736\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[105.6388, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u273b\u001b[20G\u001b[38;5;246m6\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
