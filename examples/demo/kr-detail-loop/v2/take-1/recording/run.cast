[69.4813, "o", "\u001b[?25l\u001b[H \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m 12 -\u001b[38;5;231m## \uc57d\uc0ac\uac00 \uba3c\uc800 \uad8c\ud569\ub2c8\ub2e4                                                            \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;167m\u001b[48;5;52m 13 -\u001b[38;5;231m\"\ud608\ub2f9\uc774 \uac71\uc815\ub418\ub294 \ubd84\ub4e4\uaed8 \uc57d\uad6d\uc5d0\uc11c\ub3c4 \uac00\uc7a5 \uba3c\uc800 \uad8c\ud558\ub294 \uc81c\ud488\uc785\ub2c8\ub2e4.\" (\ud604\uc9c1 \uc57d\uc0ac \uae40OO)  \r\u001b[5C\u001b[1B\u001b[38;5;167m 14 -\u001b[38;5;231m                                                                                   \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 12 \u001b[22m ## \ud558\ub8e8 \ud55c \uc54c, \uc2dd\uc0ac \uc804\uc5d0\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 13 \u001b[22m 1\uc77c 1\ud68c 1\uc815. \ubb3c\uacfc \ud568\uaed8 \uc2dd\uc0ac 30\ubd84 \uc804\uc5d0 \ub4dc\uc138\uc694.\r\u001b[6C\u001b[1B\u001b[2m14\u001b[11G\u001b[22m\uc791\uc740\u001b[16G\uc815\uc81c\ub77c\u001b[23G\uc0bc\ud0a4\uae30 \ud3b8\ud558\uace0, \ud55c \ud1b5\uc73c\ub85c 30\uc77c\uc744 \ucc59\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mNext: \uc21c\uc704\u00b7\uc778\uc99d \uacfc\uc7a5(no_rank_hype). 3\ud589\uc744 \uc0ac\uc2e4 \uadf8\ub300\ub85c \ubc14\uafc9\ub2c8\ub2e4.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m \u001b[22m # \uc232\uacb0 \ubc14\ub098\ubc14 \uc815 | \ud608\ub2f9 \uac71\uc815, \uc774\uc81c \ub05d\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 2 \u001b[22m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;167m\u001b[48;5;52m 3 -\u001b[38;5;231m\ud310\ub9e4 1\uc704 \u00b7 \uc2dd\uc57d\ucc98 \uc778\uc99d \ud608\ub2f9 \uc601\uc591\uc81c                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 3 +\u001b[38;5;231m\uc2dd\uc57d\ucc98 \uace0\uc2dc\ud615 \uae30\ub2a5\uc131 \uc6d0\ub8cc \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c                                           \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 4 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 5 \u001b[22m \uac74\uac15\uac80\uc9c4 \uacb0\uacfc\uc9c0\uc5d0 '\ud608\ub2f9 \uad00\ub9ac \ud544\uc694'\ub77c\uace0 \uc801\ud600 \uc788\uc5c8\ub098\uc694?\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 6 \u001b[22m \uc810\uc2ec \uba39\uace0 \ub098\uba74 \uc720\ub09c\ud788 \ub098\ub978\ud55c \uc624\ud6c4\uac00 \uacc4\uc18d\ub41c\ub2e4\uba74, \uc2dd\ud6c4\ubd80\ud130 \ucc59\uaca8\ubcf4\uc138\uc694.\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
