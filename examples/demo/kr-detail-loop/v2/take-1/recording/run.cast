[106.0471, "o", "\u001b[?25l\u001b[H\r\u001b[40C\u001b[23B\u001b[38;5;246mthought for 9s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[106.0986, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;246m \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[106.1328, "o", "\u001b[?25l\u001b[H\u001b[3G\u2502\u001b[10G\u2502\u001b[17G\u2502\u001b[25G\u2502\u001b[27G\uc784\uc758\ub85c\u001b[34G\uc911\ub2e8\ud558\uc9c0\u001b[43G\ub9c8\uc138\uc694.\"\u001b[97G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 3    \u2502 29   \u2502\u001b[19G\ubc18\ub824\u001b[25G\u2502\u001b[27G\u001b[1m\uc804\ubb38\uac00 \ucd94\ucc9c(no_endorsement)\u001b[22m:\u001b[56G'\uc57d\uc0ac\uac00\u001b[64G\uba3c\uc800\u001b[69G\uad8c\ud569\ub2c8\ub2e4'\u001b[79G\uc139\uc158\u001b[84G\uc0ad\uc81c\u001b[97G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B \u001b[3G\u2502 4  \u001b[9G \u2502 43   \u2502 \ubc18\ub824  \u2502 \u001b[1m\uc21c\uc704\u00b7\uc778\uc99d \uacfc\uc7a5(no_rank_hype)\u001b[22m: \"\ud310\ub9e4 1\uc704 \u00b7\u001b[69G\uc2dd\uc57d\ucc98 \uc778\uc99d \ud608\ub2f9 \uc601\uc591\uc81c\" \u2192  \u2502\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[10G\u2502\u001b[17G\u2502\u001b[25G\u2502\u001b[27G\"\uc2dd\uc57d\ucc98\u001b[35G\uace0\uc2dc\ud615\u001b[42G\uae30\ub2a5\uc131\u001b[49G\uc6d0\ub8cc\u001b[54G\ubc14\ub098\ubc14\uc78e\u001b[63G\ucd94\ucd9c\ubb3c\"\u001b[97G\u2502\r\u001b[1B \u001b[3G\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B  \u2502 5    \u2502\u001b[12G58   \u2502 \ubc18\ub824\u001b[25G\u2502\u001b[27G\u001b[1m\ud6c4\uae30(honest_reviews)\u001b[22m:\u001b[49G\uacf5\ubcf5\ud608\ub2f9\u001b[58G\uc218\uce58\uac00\u001b[65G\uc815\uc0c1\uc774\u001b[72G\ub410\ub2e4\ub294\u001b[79G\ud6c4\uae30\u001b[84G\u2192\u001b[86G\uc54c\uc57d\uc774\u001b[97G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[6G    \u2502      \u2502       \u2502 \uc791\uc544 \ucc59\uaca8 \uba39\uae30 \ud3b8\ud558\ub2e4\ub294 \ud6c4\uae30              \u001b[97G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[6G    \u2502      \u2502 \uc218\uc815  \u2502 \u001b[1m\ud6a8\uacfc \ud45c\ud604(effect_scope)\u001b[22m:\u001b[52G\uc81c\ubaa9\u001b[57G\"\ud608\ub2f9\u001b[63G\uac71\uc815,\u001b[69G\uc774\uc81c\u001b[74G\ub05d\"\u001b[78G\u2192\u001b[80G\"\uc2dd\uc0ac\u001b[86G\uc804\u001b[89G\ud55c\u001b[92G\uc54c,\u001b[97G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[5G6    \u2502 75   \u2502 \ud544\uc694  \u2502 \uc2dd\ud6c4 \ud608\ub2f9 \uad00\ub9ac\" / \"\ud608\ub2f9\uc774 \ub69d \ub5a8\uc5b4\uc9c0\uace0 \ud6a8\uacfc 100% \ubcf4\uc7a5\" \u2192 \"\uc2dd\ud6c4      \u001b[97G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[6G    \u2502      \u2502       \u2502 \ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4\"                             \u001b[97G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5G7    \u2502 \u001b[1m94\u001b[22m   \u2502 \u001b[1m\uac8c\uc2dc \u001b[22m \u2502 \u001b[1m\ud544\uc218 \uc815\ubcf4(required_info)\u001b[22m: '\uac74\uac15\uae30\ub2a5\uc2dd\ud488' \ud45c\uae30, \uae30\ub2a5\uc131,             \u001b[97G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[6G    \u2502      \u2502 \u001b[1m\uac00\ub2a5\u001b[22m  \u2502 \uc12d\ucde8\ub7c9\u00b7\uc12d\ucde8\ubc29\ubc95, \uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ucd94\uac00                             \u001b[97G\u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ucc38\uace0\ud560 \uc810\r\u001b[5C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m'\ud55c \uac00\uc9c0\ub9cc'\uc758 \ubc94\uc704:\u001b[25G\u001b[22m\ud68c\ucc28\ub9c8\ub2e4\u001b[34G\uae30\uc900\u001b[39G\ud558\ub098\ub9cc\u001b[46G\uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[58G\ub2e4\ub9cc\u001b[63G6\ud68c\ucc28\ub294\u001b[71G\uac19\uc740\u001b[76G\uae30\uc900\uc5d0\u001b[83G\uac78\ub9b0\u001b[88G\ubb38\uc7a5\u001b[93G\ub450\u001b[96G\uac1c\ub97c,\r\u001b[1B \u001b[3G  7\ud68c\ucc28\ub294 \uac19\uc740 \uae30\uc900\uc5d0\uc11c\u001b[27G\ube60\uc9c4\u001b[32G\ud56d\ubaa9\u001b[37G\ub450\u001b[40G\uac1c\ub97c\u001b[45G\ud568\uaed8\u001b[50G\uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[62G2\ud68c\ucc28\uc5d0\u001b[70G\ub123\uc740\u001b[75G'\uc758\uc57d\ud488\uc774\u001b[85G\uc544\ub2d9\ub2c8\ub2e4'\r\u001b[4C\u001b[1B\ubb38\uad6c\ub3c4\u001b[12G\ud544\uc218\u001b[17G\uc815\ubcf4\u001b[22G\ub2e4\uc12f\u001b[27G\uac00\uc9c0\u001b[32G\uc911\u001b[35G\ud558\ub098\uc785\ub2c8\ub2e4.\u001b[47G\ub2e4\ub9cc\u001b[52G\uadf8\u001b[55G\uae30\uc900\uc740\u001b[62G7\ud68c\ucc28\uc5d0\uc11c\uc57c\u001b[74G\ud1b5\uacfc\ud588\uc73c\ub2c8,\u001b[86G\uac01\u001b[89G\ud68c\ucc28\uc758\u001b[96G\uc810\uc218\r\u001b[1B \u001b[3G  \ubcc0\ud654\ub294 \uadf8 \ud68c\ucc28\uc5d0 \uace0\uce5c\u001b[27G\uae30\uc900 \ub54c\ubb38\uc785\ub2c8\ub2e4.\u001b[K\r\u001b"]
[106.1329, "o", "[1B  - \u001b[1m\uac19\uc774 \uc624\ub978 trust \uc810\uc218:\u001b[22m 6~7\ud68c\ucc28\uc5d0 \uc778\uc815 \ubb38\uad6c\uc640 \uc8fc\uc758\uc0ac\ud56d\uc774 \ub4e4\uc5b4\uac00\uba74\uc11c '\ud655\uc778\ud560 \uc218 \uc788\ub294 \uadfc\uac70(trust)'\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[106.2742, "o", "\u001b[?25l\u001b[H\u001b[5G3\u001b[12G29\u001b[19G\ubc18\ub824\u001b[27G\u001b[1m\uc804\ubb38\uac00 \ucd94\ucc9c(no_endorsement)\u001b[22m:\u001b[56G'\uc57d\uc0ac\uac00\u001b[64G\uba3c\uc800\u001b[69G\uad8c\ud569\ub2c8\ub2e4'\u001b[79G\uc139\uc158\u001b[84G\uc0ad\uc81c\r\u001b[4C\u001b[2B4\u001b[12G43\u001b[27G\u001b[1m\uc21c\uc704\u00b7\uc778\uc99d \uacfc\uc7a5(no_rank_hype)\u001b[22m: \"\ud310\ub9e4 1\uc704 \u00b7\u001b[69G\uc2dd\uc57d\ucc98 \uc778\uc99d \ud608\ub2f9 \uc601\uc591\uc81c\"\u001b[94G\u2192\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502       \u2502 \"\uc2dd\uc57d\ucc98 \uace0\uc2dc\ud615 \uae30\ub2a5\uc131 \uc6d0\ub8cc \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c\"                           \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[4C\u001b[1B5\u001b[12G58\u001b[19G\ubc18\ub824\u001b[27G\u001b[1m\ud6c4\uae30(honest_reviews)\u001b[22m:\u001b[49G\uacf5\ubcf5\ud608\ub2f9 \uc218\uce58\uac00 \uc815\uc0c1\uc774\u001b[72G\ub410\ub2e4\ub294\u001b[79G\ud6c4\uae30\u001b[84G\u2192\u001b[86G\uc54c\uc57d\uc774\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502       \u2502 \uc791\uc544 \ucc59\uaca8 \uba39\uae30 \ud3b8\ud558\ub2e4\ub294 \ud6c4\uae30                                          \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[18C\u001b[1B\uc218\uc815\u001b[27G\u001b[1m\ud6a8\uacfc \ud45c\ud604(effect_scope)\u001b[22m: \uc81c\ubaa9\u001b[57G\"\ud608\ub2f9\u001b[63G\uac71\uc815,\u001b[69G\uc774\uc81c\u001b[74G\ub05d\"\u001b[78G\u2192\u001b[80G\"\uc2dd\uc0ac\u001b[86G\uc804\u001b[89G\ud55c\u001b[92G\uc54c,\r\u001b[2C\u001b[1B\u2502 6    \u2502 75   \u2502 \ud544\uc694  \u2502 \uc2dd\ud6c4 \ud608\ub2f9 \uad00\ub9ac\" / \"\ud608\ub2f9\uc774 \ub69d \ub5a8\uc5b4\uc9c0\uace0 \ud6a8\uacfc 100% \ubcf4\uc7a5\" \u2192 \"\uc2dd\ud6c4         \u2502\r\u001b[18C\u001b[1B    \u001b[27G\ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4\"   \u001b[69G    \u001b[74G   \u001b[78G \u001b[80G     \u001b[86G  \u001b[89G  \u001b[92G   \r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[4C\u001b[1B7\u001b[12G\u001b[1m94\u001b[19G\uac8c\uc2dc \u001b[27G\ud544\uc218 \uc815\ubcf4(required_info)\u001b[22m:\u001b[53G'\uac74\uac15\uae30\ub2a5\uc2dd\ud488'\u001b[68G\ud45c\uae30,\u001b[74G\uae30\ub2a5\uc131,\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502 \u001b[1m\uac00\ub2a5\u001b[22m  \u2502 \uc12d\ucde8\ub7c9\u00b7\uc12d\ucde8\ubc29\ubc95, \uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ucd94\uac00                                \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ucc38\uace0\ud560 \uc810\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1m'\ud55c \uac00\uc9c0\ub9cc'\uc758 \ubc94\uc704:\u001b[25G\u001b[22m\ud68c\ucc28\ub9c8\ub2e4\u001b[34G\uae30\uc900\u001b[39G\ud558\ub098\ub9cc\u001b[46G\uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[58G\ub2e4\ub9cc\u001b[63G6\ud68c\ucc28\ub294\u001b[71G\uac19\uc740\u001b[76G\uae30\uc900\uc5d0\u001b[83G\uac78\ub9b0\u001b[88G\ubb38\uc7a5\u001b[93G\ub450\u001b[96G\uac1c\ub97c,\r\u001b[4C\u001b[1B7\ud68c\ucc28\ub294\u001b[13G\uac19\uc740\u001b[18G\uae30\uc900\uc5d0\uc11c\u001b[27G\ube60\uc9c4\u001b[32G\ud56d\ubaa9\u001b[37G\ub450\u001b[40G\uac1c\ub97c\u001b[45G\ud568\uaed8\u001b[50G\uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[62G2\ud68c\ucc28\uc5d0\u001b[70G\ub123\uc740\u001b[75G'\uc758\uc57d\ud488\uc774\u001b[85G\uc544\ub2d9\ub2c8\ub2e4'\r\u001b[2C\u001b[1B \u001b[5G\ubb38\uad6c\ub3c4 \ud544\uc218 \uc815\ubcf4 \ub2e4\uc12f \uac00\uc9c0 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4. \ub2e4\ub9cc \uadf8 \uae30\uc900\uc740 7\ud68c\ucc28\uc5d0\uc11c\uc57c \ud1b5\uacfc\ud588\uc73c\ub2c8, \uac01 \ud68c\ucc28\uc758\u001b[96G\uc810\uc218\u001b[K\r\u001b[4C\u001b[1B\ubcc0\ud654\ub294 \uadf8 \ud68c\ucc28\uc5d0 \uace0\uce5c\u001b[27G\uae30\uc900\u001b[32G\ub54c\ubb38\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\uac19\uc774 \uc624\ub978 trust \uc810\uc218:\u001b[27G\u001b[22m6~7\ud68c\ucc28\uc5d0 \uc778\uc815 \ubb38\uad6c\uc640 \uc8fc\uc758\uc0ac\ud56d\uc774 \ub4e4\uc5b4\uac00\uba74\uc11c '\ud655\uc778\ud560 \uc218 \uc788\ub294 \uadfc\uac70(trust)'\u001b[K\r\u001b[4C\u001b[1B\uc810\uc218\ub3c4\u001b[12G1.9\uc5d0\uc11c 4.0\uc73c\ub85c \ud568\uaed8 \uc62c\ub790\uc2b5\ub2c8\ub2e4.\r\u001b[4C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[106.8635, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[24B\u001b[1m\ud310\uc815 \ud655\uc2e0\ub3c4\uac00 \ub192\uc9c0 \uc54a\uc740 \uae30\uc900:\u001b[35G\u001b[22m\uac8c\uc774\ud2b8\ub294\u001b[44G2\ud68c\ucc28\uc5d0\u001b[52G\uc900\uc218\u001b[57G\ud655\ub960\u001b[62G58%\ub85c\u001b[68G\uaca8\uc6b0\u001b[73G\ub118\uc5c8\uace0,\u001b[81G\uc9c0\uae08\uc740\u001b[88G81%\uc785\ub2c8\ub2e4.\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[107.3173, "o", "\u001b[?25l\u001b[H\u001b[5G4\u001b[12G43\u001b[27G\u001b[1m\uc21c\uc704\u00b7\uc778\uc99d \uacfc\uc7a5(no_rank_hype)\u001b[22m: \"\ud310\ub9e4 1\uc704 \u00b7\u001b[69G\uc2dd\uc57d\ucc98 \uc778\uc99d \ud608\ub2f9 \uc601\uc591\uc81c\"\u001b[94G\u2192\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502       \u2502 \"\uc2dd\uc57d\ucc98 \uace0\uc2dc\ud615 \uae30\ub2a5\uc131 \uc6d0\ub8cc \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c\"                           \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[4C\u001b[1B5\u001b[12G58\u001b[19G\ubc18\ub824\u001b[27G\u001b[1m\ud6c4\uae30(honest_reviews)\u001b[22m:\u001b[49G\uacf5\ubcf5\ud608\ub2f9 \uc218\uce58\uac00 \uc815\uc0c1\uc774\u001b[72G\ub410\ub2e4\ub294\u001b[79G\ud6c4\uae30\u001b[84G\u2192\u001b[86G\uc54c\uc57d\uc774\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502       \u2502 \uc791\uc544 \ucc59\uaca8 \uba39\uae30 \ud3b8\ud558\ub2e4\ub294 \ud6c4\uae30                                          \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[18C\u001b[1B\uc218\uc815\u001b[27G\u001b[1m\ud6a8\uacfc \ud45c\ud604(effect_scope)\u001b[22m: \uc81c\ubaa9\u001b[57G\"\ud608\ub2f9\u001b[63G\uac71\uc815,\u001b[69G\uc774\uc81c\u001b[74G\ub05d\"\u001b[78G\u2192\u001b[80G\"\uc2dd\uc0ac\u001b[86G\uc804\u001b[89G\ud55c\u001b[92G\uc54c,\r\u001b[2C\u001b[1B\u2502 6    \u2502 75   \u2502 \ud544\uc694  \u2502 \uc2dd\ud6c4 \ud608\ub2f9 \uad00\ub9ac\" / \"\ud608\ub2f9\uc774 \ub69d \ub5a8\uc5b4\uc9c0\uace0 \ud6a8\uacfc 100% \ubcf4\uc7a5\" \u2192 \"\uc2dd\ud6c4         \u2502\r\u001b[18C\u001b[1B    \u001b[27G\ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4\"   \u001b[69G    \u001b[74G   \u001b[78G \u001b[80G     \u001b[86G  \u001b[89G  \u001b[92G   \r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[4C\u001b[1B7\u001b[12G\u001b[1m94\u001b[19G\uac8c\uc2dc \u001b[27G\ud544\uc218 \uc815\ubcf4(required_info)\u001b[22m:\u001b[53G'\uac74\uac15\uae30\ub2a5\uc2dd\ud488'\u001b[68G\ud45c\uae30,\u001b[74G\uae30\ub2a5\uc131,\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502 \u001b[1m\uac00\ub2a5\u001b[22m  \u2502 \uc12d\ucde8\ub7c9\u00b7\uc12d\ucde8\ubc29\ubc95, \uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ucd94\uac00                                \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ucc38\uace0\ud560 \uc810\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1m'\ud55c \uac00\uc9c0\ub9cc'\uc758 \ubc94\uc704:\u001b[25G\u001b[22m\ud68c\ucc28\ub9c8\ub2e4\u001b[34G\uae30\uc900\u001b[39G\ud558\ub098\ub9cc\u001b[46G\uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[58G\ub2e4\ub9cc\u001b[63G6\ud68c\ucc28\ub294\u001b[71G\uac19\uc740\u001b[76G\uae30\uc900\uc5d0\u001b[83G\uac78\ub9b0\u001b[88G\ubb38\uc7a5\u001b[93G\ub450\u001b[96G\uac1c\ub97c,\r\u001b[4C\u001b[1B7\ud68c\ucc28\ub294\u001b[13G\uac19\uc740\u001b[18G\uae30\uc900\uc5d0\uc11c\u001b[27G\ube60\uc9c4\u001b[32G\ud56d\ubaa9\u001b[37G\ub450\u001b[40G\uac1c\ub97c\u001b[45G\ud568\uaed8\u001b[50G\uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[62G2\ud68c\ucc28\uc5d0\u001b[70G\ub123\uc740\u001b[75G'\uc758\uc57d\ud488\uc774\u001b[85G\uc544\ub2d9\ub2c8\ub2e4'\r\u001b[2C\u001b[1B \u001b[5G\ubb38\uad6c\ub3c4 \ud544\uc218 \uc815\ubcf4 \ub2e4\uc12f \uac00\uc9c0 \uc911 \ud558\ub098\uc785\ub2c8\ub2e4. \ub2e4\ub9cc \uadf8 \uae30\uc900\uc740 7\ud68c\ucc28\uc5d0\uc11c\uc57c \ud1b5\uacfc\ud588\uc73c\ub2c8, \uac01 \ud68c\ucc28\uc758\u001b[96G\uc810\uc218\u001b[K\r\u001b[4C\u001b[1B\ubcc0\ud654\ub294 \uadf8 \ud68c\ucc28\uc5d0 \uace0\uce5c\u001b[27G\uae30\uc900\u001b[32G\ub54c\ubb38\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\uac19\uc774 \uc624\ub978 trust \uc810\uc218:\u001b[27G\u001b[22m6~7\ud68c\ucc28\uc5d0 \uc778\uc815 \ubb38\uad6c\uc640 \uc8fc\uc758\uc0ac\ud56d\uc774 \ub4e4\uc5b4\uac00\uba74\uc11c '\ud655\uc778\ud560 \uc218 \uc788\ub294 \uadfc\uac70(trust)'\u001b[K\r\u001b[4C\u001b[1B\uc810\uc218\ub3c4\u001b[12G1.9\uc5d0\uc11c 4.0\uc73c\ub85c \ud568\uaed8 \uc62c\ub790\uc2b5\ub2c8\ub2e4.\r\u001b[4C\u001b[1B\u001b[1m\ud310\uc815\u001b[10G\ud655\uc2e0\ub3c4\uac00 \ub192\uc9c0 \uc54a\uc740 \uae30\uc900:\u001b[22m \uac8c\uc774\ud2b8\ub294 2\ud68c\ucc28\uc5d0 \uc900\uc218 \ud655\ub960 58%\ub85c \uaca8\uc6b0 \ub118\uc5c8\uace0, \uc9c0\uae08\uc740 81%\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[4C\u001b[1B\ucd5c\uc885 \ud68c\ucc28\uc5d0\uc11c\ub3c4 \ud6a8\uacfc \ud45c\ud604\uacfc\u001b[33G\ud544\uc218 \uc815\ubcf4 \ud310\uc815\uc740\u001b[50G\uc900\uc218\u001b[55G\ud655\ub960\uc774\u001b[62G81%\u001b[66G\uc815\ub3c4\uc785\ub2c8\ub2e4.\r\u001b[4C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[107.8616, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[24B\u001b[1m\uaf2d \ud655\uc778\ud574 \uc8fc\uc138\uc694:\u001b[23G\u001b[22m\uc12d\ucde8\u001b[28G\uc2dc\u001b[31G\uc8fc\uc758\uc0ac\ud56d\u001b[40G\ubb38\uad6c(\"\uc9c8\ud658\uc774\u001b[53G\uc788\uac70\ub098\u001b[60G\uc758\uc57d\ud488\uc744\u001b[69G\ubcf5\uc6a9\u001b[74G\uc911\uc778\u001b[79G\ubd84,\u001b[83G\uc784\uc0b0\ubd80\u00b7\uc218\uc720\ubd80\ub294\u001b[99G\u2026\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[108.6133, "o", "\u001b[?25l\u001b[H\u001b[5G \u001b[12G  \u001b[19G    \u001b[27G\"\uc2dd\uc57d\ucc98 \uace0\uc2dc\ud615 \uae30\ub2a5\uc131 \uc6d0\ub8cc \ubc14\ub098\ubc14\uc78e\u001b[63G\ucd94\ucd9c\ubb3c\"     \u001b[76G    \u001b[81G    \u001b[86G       \u001b[94G \r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 5    \u2502 58   \u2502 \ubc18\ub824  \u2502 \u001b[1m\ud6c4\uae30(honest_reviews)\u001b[22m: \uacf5\ubcf5\ud608\ub2f9 \uc218\uce58\uac00 \uc815\uc0c1\uc774 \ub410\ub2e4\ub294 \ud6c4\uae30 \u2192 \uc54c\uc57d\uc774     \u2502\r\u001b[4C\u001b[1B \u001b[12G  \u001b[19G    \u001b[27G\uc791\uc544 \ucc59\uaca8 \uba39\uae30 \ud3b8\ud558\ub2e4\ub294 \ud6c4\uae30  \u001b[58G      \u001b[65G      \u001b[72G      \u001b[79G    \u001b[84G \u001b[86G      \r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502 \uc218\uc815  \u2502 \u001b[1m\ud6a8\uacfc \ud45c\ud604(effect_scope)\u001b[22m: \uc81c\ubaa9 \"\ud608\ub2f9 \uac71\uc815, \uc774\uc81c \ub05d\" \u2192 \"\uc2dd\uc0ac \uc804 \ud55c \uc54c,  \u2502\r\u001b[4C\u001b[1B6\u001b[12G75\u001b[19G\ud544\uc694\u001b[27G\uc2dd\ud6c4 \ud608\ub2f9 \uad00\ub9ac\" / \"\ud608\ub2f9\uc774 \ub69d \ub5a8\uc5b4\uc9c0\uace0 \ud6a8\uacfc 100% \ubcf4\uc7a5\" \u2192 \"\uc2dd\ud6c4\u001b[89G  \u001b[92G   \r\u001b[4C\u001b[1B \u001b[12G  \u001b[19G    \u001b[27G\ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0\u001b[43G\ub3c4\uc6c0\uc744 \uc904\u001b[53G\uc218\u001b[56G\uc788\uc2b5\ub2c8\ub2e4\"    \u001b[70G    \u001b[75G     \u001b[81G \u001b[83G     \r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 7    \u2502 \u001b[1m94\u001b[22m   \u2502 \u001b[1m\uac8c\uc2dc \u001b[22m \u2502 \u001b[1m\ud544\uc218 \uc815\ubcf4(required_info)\u001b[22m: '\uac74\uac15\uae30\ub2a5\uc2dd\ud488' \ud45c\uae30, \uae30\ub2a5\uc131,                \u2502\r\u001b[4C\u001b[1B \u001b[12G  \u001b[19G\u001b[1m\uac00\ub2a5\u001b[22m \u001b[27G\uc12d\ucde8\ub7c9\u00b7\uc12d\ucde8\ubc29\ubc95, \uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ucd94\uac00  \u001b[68G     \u001b[74G       \r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ucc38\uace0\ud560 \uc810\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m'\ud55c \uac00\uc9c0\ub9cc'\uc758 \ubc94\uc704:\u001b[25G\u001b[22m\ud68c\ucc28\ub9c8\ub2e4\u001b[34G\uae30\uc900\u001b[39G\ud558\ub098\ub9cc\u001b[46G\uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[58G\ub2e4\ub9cc\u001b[63G6\ud68c\ucc28\ub294\u001b[71G\uac19\uc740\u001b[76G\uae30\uc900\uc5d0\u001b[83G\uac78\ub9b0\u001b[88G\ubb38\uc7a5\u001b[93G\ub450\u001b[96G\uac1c\ub97c,\r\u001b[2C\u001b[1B \u001b[5G7\ud68c\ucc28\ub294 \uac19\uc740 \uae30\uc900\uc5d0\uc11c \ube60\uc9c4 \ud56d\ubaa9 \ub450 \uac1c\ub97c \ud568\uaed8 \uace0\ucce4\uc2b5\ub2c8\u001b[60G. 2\ud68c\ucc28\uc5d0 \ub123\uc740 '\uc758\uc57d\ud488\uc774 \uc544\ub2d9\ub2c8\ub2e4'\u001b[K\r\u001b[4C\u001b[1B\ubb38\uad6c\ub3c4 \ud544\uc218 \uc815\ubcf4 \ub2e4\uc12f\u001b[27G\uac00\uc9c0\u001b[32G\uc911 \ud558\ub098\uc785\ub2c8\ub2e4. \ub2e4\ub9cc \uadf8 \uae30\uc900\uc740\u001b[62G7\u001b[69G\uc11c\uc57c \ud1b5\uacfc\ud588\uc73c\ub2c8, \uac01 \ud68c\ucc28\uc758\u001b[96G\uc810\uc218\r\u001b[4C\u001b[1B\ubcc0\ud654\ub294\u001b[12G\uadf8 \ud68c\ucc28\uc5d0\u001b[22G\uace0\uce5c\u001b[27G\uae30\uc900\u001b[32G\ub54c\ubb38\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\uac19\uc774 \uc624\ub978 trust \uc810\uc218:\u001b[27G\u001b[22m6~7\ud68c\ucc28\uc5d0 \uc778\uc815 \ubb38\uad6c\uc640\u001b[49G\uc8fc\uc758\uc0ac\ud56d\uc774\u001b[60G\ub4e4\uc5b4\uac00\uba74\uc11c\u001b[71G'\ud655\uc778\ud560\u001b[79G\uc218\u001b[82G\uc788\ub294\u001b[87G\uadfc\uac70(trust)'\r\u001b[2C\u001b[1B \u001b[5G\uc810\uc218\ub3c4 1.9\uc5d0\uc11c 4.0\uc73c\ub85c \ud568\uaed8 \uc62c\ub790\uc2b5\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\ud310\uc815 \ud655\uc2e0\ub3c4\uac00 \ub192\uc9c0 \uc54a\uc740 \uae30\uc900:\u001b[22m \uac8c\uc774\ud2b8\ub294 2\ud68c\ucc28\uc5d0\u001b[52G\uc900\uc218\u001b[57G\ud655\ub960\u001b[62G58%\ub85c\u001b[68G\uaca8\uc6b0\u001b[73G\ub118\uc5c8\uace0,\u001b[81G\uc9c0\uae08\uc740\u001b[88G81%\uc785\ub2c8\ub2e4.\r\u001b[2C\u001b[1B \u001b[5G\ucd5c\uc885 \ud68c\ucc28\uc5d0\uc11c\ub3c4 \ud6a8\uacfc \ud45c\ud604\uacfc \ud544\uc218 \uc815\ubcf4 \ud310\uc815\uc740 \uc900\uc218 \ud655\ub960\uc774\u001b[62G81\u001b[65G \uc815\ub3c4\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\uaf2d \ud655\uc778\ud574 \uc8fc\uc138\uc694:\u001b[22m \uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ubb38\uad6c(\"\uc9c8\ud658\uc774 \uc788\uac70\ub098 \uc758\uc57d\ud488\uc744 \ubcf5\uc6a9 \uc911\uc778\u001b[79G\ubd84,\u001b[83G\uc784\uc0b0\ubd80\u00b7\uc218\uc720\ubd80\ub294\u001b[99G\u2026\r\u001b[2C\u001b[1B \u001b[5G\uc0c1\ub2f4\")\ub294 \ube0c\ub9ac\ud504\uc5d0\u001b[23G\uc5c6\uc5b4\uc11c \uc77c\ubc18\uc801\uc778 \uc608\uc2dc\ub85c \uc81c\uac00 \uc4f4 \uac83\uc785\ub2c8\ub2e4. \uc62c\ub9ac\uae30 \uc804\uc5d0 \uc2e4\uc81c \uc81c\ud488 \ud45c\uc2dc\uc0ac\ud56d\uc73c\ub85c\u001b[99G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[109.0354, "o", "\u001b[?25l\u001b[H\u001b[3G\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502 \uc218\uc815  \u2502 \u001b[1m\ud6a8\uacfc \ud45c\ud604(effect_scope)\u001b[22m: \uc81c\ubaa9 \"\ud608\ub2f9 \uac71\uc815, \uc774\uc81c \ub05d\" \u2192 \"\uc2dd\uc0ac \uc804 \ud55c \uc54c,  \u2502\r\u001b[4C\u001b[1B6\u001b[12G75\u001b[19G\ud544\uc694\u001b[27G\uc2dd\ud6c4 \ud608\ub2f9 \uad00\ub9ac\" / \"\ud608\ub2f9\uc774 \ub69d \ub5a8\uc5b4\uc9c0\uace0\u001b[65G\ud6a8\uacfc 100% \ubcf4\uc7a5\" \u2192 \"\uc2dd\ud6c4    \r\u001b[26C\u001b[1B\ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218\u001b[56G\uc788\uc2b5\ub2c8\ub2e4\"\r\u001b[4C\u001b[2B7\u001b[12G\u001b[1m94\u001b[19G\uac8c\uc2dc \u001b[27G\ud544\uc218\u001b[32G\uc815\ubcf4\u001b[37Grequired_info)\u001b[22m: '\uac74\uac15\uae30\ub2a5\uc2dd\ud488' \ud45c\uae30,\u001b[74G\uae30\ub2a5\uc131,    \u001b[86G  \u001b[89G  \u001b[92G   \r\u001b[4C\u001b[1B \u001b[12G  \u001b[19G\u001b[1m\uac00\ub2a5\u001b[27G\u001b[22m\uc12d\ucde8\ub7c9\u00b7\uc12d\ucde8\ubc29\ubc95, \uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ucd94\uac00    \u001b[70G    \u001b[75G     \u001b[81G \u001b[83G     \r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ucc38\uace0\ud560 \uc810\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[1m'\ud55c \uac00\uc9c0\ub9cc'\uc758 \ubc94\uc704:\u001b[22m \ud68c\ucc28\ub9c8\ub2e4 \uae30\uc900 \ud558\ub098\ub9cc \uace0\ucce4\uc2b5\ub2c8\ub2e4. \ub2e4\ub9cc 6\ud68c\ucc28\ub294 \uac19\uc740 \uae30\uc900\uc5d0 \uac78\ub9b0 \ubb38\uc7a5 \ub450 \uac1c\ub97c,\r\u001b[4C\u001b[1B7\ud68c\ucc28\ub294\u001b[13G\uac19\uc740\u001b[18G\uae30\uc900\uc5d0\uc11c\u001b[27G\ube60\uc9c4\u001b[32G\ud56d\ubaa9\u001b[37G\ub450\u001b[40G\uac1c\ub97c\u001b[45G\ud568\uaed8\u001b[50G\uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[62G2\ud68c\ucc28\uc5d0\u001b[70G\ub123\uc740\u001b[75G'\uc758\uc57d\ud488\uc774\u001b[85G\uc544\ub2d9\ub2c8\ub2e4'\r\u001b[2C\u001b[1B  \ubb38\uad6c\ub3c4 \ud544\uc218\u001b[17G\uc815\ubcf4\u001b[22G\ub2e4\uc12f\u001b[27G\uac00\uc9c0\u001b[32G\uc911\u001b[35G\ud558\ub098\uc785\ub2c8\ub2e4.\u001b[47G\ub2e4\ub9cc\u001b[52G\uadf8\u001b[55G\uae30\uc900\uc740\u001b[62G7\ud68c\ucc28\uc5d0\uc11c\uc57c\u001b[74G\ud1b5\uacfc\ud588\uc73c\ub2c8,\u001b[86G\uac01\u001b[89G\ud68c\ucc28\uc758\u001b[96G\uc810\uc218\r\u001b[4C\u001b[1B\ubcc0\ud654\ub294\u001b[12G\uadf8\u001b[15G\ud68c\ucc28\uc5d0\u001b[22G\uace0\uce5c\u001b[27G\uae30\uc900\u001b[32G\ub54c\ubb38\uc785\ub2c8\ub2e4.\r\u001b[4C\u001b[1B\u001b[1m\uac19\uc774 \uc624\ub978 trust \uc810\uc218:\u001b[22m 6~7\ud68c\ucc28\uc5d0 \uc778\uc815 \ubb38\uad6c\uc640 \uc8fc\uc758\uc0ac\ud56d\uc774 \ub4e4\uc5b4\uac00\uba74\uc11c\u001b[71G'\ud655\uc778\ud560 \uc218 \uc788\ub294 \uadfc\uac70(trust)'\u001b[K\r\u001b[4C\u001b[1B\uc810\uc218\ub3c4 1.9\uc5d0\uc11c 4.0\uc73c\ub85c \ud568\uaed8 \uc62c\ub790\uc2b5\ub2c8\ub2e4.\u001b[45G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\ud310\uc815 \ud655\uc2e0\ub3c4\uac00 \ub192\uc9c0 \uc54a\uc740 \uae30\uc900:\u001b[35G\u001b[22m\uac8c\uc774\ud2b8\ub294 2\ud68c\ucc28\uc5d0\u001b[52G\uc900\uc218 \ud655\ub960\u001b[62G58%\ub85c \uaca8\uc6b0 \ub118\uc5c8\uace0, \uc9c0\uae08\uc740 81%\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[4C\u001b[1B\ucd5c\uc885 \ud68c\ucc28\uc5d0\uc11c\ub3c4 \ud6a8\uacfc \ud45c\ud604\uacfc \ud544\uc218 \uc815\ubcf4 \ud310\uc815\uc740\u001b[50G\uc900\uc218\u001b[55G\ud655\ub960\uc774\u001b[62G81%\u001b[66G\uc815\ub3c4\uc785\ub2c8\ub2e4.\r\u001b[4C\u001b[1B\u001b[1m\uaf2d \ud655\uc778\ud574\u001b[15G\uc8fc\uc138\uc694:\u001b[22m \uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ubb38\uad6c(\"\uc9c8\ud658\uc774 \uc788\uac70\ub098\u001b[60G\uc758\uc57d\ud488\uc744 \ubcf5\uc6a9 \uc911\uc778\u001b[79G\ubd84, \uc784\uc0b0\ubd80\u00b7\uc218\uc720\ubd80\ub294 \u2026\r\u001b[4C\u001b[1B\uc0c1\ub2f4\")\ub294 \ube0c\ub9ac\ud504\uc5d0 \uc5c6\uc5b4\uc11c \uc77c\ubc18\uc801\uc778 \uc608\uc2dc\ub85c\u001b[46G\uc81c\uac00\u001b[51G\uc4f4\u001b[54G\uac83\uc785\ub2c8\ub2e4.\u001b[64G\uc62c\ub9ac\uae30\u001b[71G\uc804\uc5d0\u001b[76G\uc2e4\uc81c\u001b[81G\uc81c\ud488\u001b[86G\ud45c\uc2dc\uc0ac\ud56d\uc73c\ub85c\r\u001b[2C\u001b[1B \u001b[5G\ubc14\uafd4 \uc8fc\uc138\uc694. \ub8e8\ube0c\ub9ad \uc8fc\uc11d\uc5d0 \uc801\ud78c \ub300\ub85c \ubc95\ub839 \uc6d0\ubb38\uacfc \uc790\uc728\uc2ec\uc758 \uae30\uc900\ub3c4 \ud655\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m\u00b7\u001b[3GSchlepp\u001b[38;5;216ming\u001b[38;5;174m\u2026 \u001b[38;5;246m(1m 29s \u00b7 \u2193\u001b[39m \u001b[38;5;246m8.4k tokens)\u001b[40G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[109.0958, "o", "\u001b[?25l\u001b[H\u001b[3G\u2502      \u2502      \u2502       \u2502 \uc791\uc544 \ucc59\uaca8 \uba39\uae30 \ud3b8\ud558\ub2e4\ub294 \ud6c4\uae30                                          \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[4C\u001b[1B \u001b[12G  \u001b[19G\uc218\uc815\u001b[27G\u001b[1m\ud6a8\uacfc \ud45c\ud604(effect_scope)\u001b[22m: \uc81c\ubaa9 \"\ud608\ub2f9 \uac71\uc815, \uc774\uc81c \ub05d\" \u2192 \"\uc2dd\uc0ac \uc804\u001b[89G\ud55c\u001b[92G\uc54c,\r\u001b[4C\u001b[1B6\u001b[12G75\u001b[19G\ud544\uc694\u001b[27G\uc2dd\ud6c4 \ud608\ub2f9 \uad00\ub9ac\"\u001b[43G/ \"\ud608\ub2f9\uc774\u001b[53G\ub69d\u001b[56G\ub5a8\uc5b4\uc9c0\uace0 \ud6a8\uacfc\u001b[70G100%\u001b[75G\ubcf4\uc7a5\"\u001b[81G\u2192\u001b[83G\"\uc2dd\ud6c4\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502       \u2502 \ud608\ub2f9\uc0c1\uc2b9 \uc5b5\uc81c\uc5d0 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4\"                                \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[4C\u001b[1B7\u001b[12G\u001b[1m94\u001b[19G\uac8c\uc2dc \u001b[27G\ud544\uc218 \uc815\ubcf4(required_info)\u001b[22m: '\uac74\uac15\uae30\ub2a5\uc2dd\ud488'\u001b[68G\ud45c\uae30,\u001b[74G\uae30\ub2a5\uc131,\r\u001b[2C\u001b[1B\u2502      \u2502      \u2502 \u001b[1m\uac00\ub2a5\u001b[22m  \u2502 \uc12d\ucde8\ub7c9\u00b7\uc12d\ucde8\ubc29\ubc95, \uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ucd94\uac00                                \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ucc38\uace0\ud560 \uc810\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m'\ud55c \uac00\uc9c0\ub9cc'\uc758 \ubc94\uc704:\u001b[22m \ud68c\ucc28\ub9c8\ub2e4 \uae30\uc900 \ud558\ub098\ub9cc \uace0\ucce4\uc2b5\ub2c8\ub2e4. \u001b[60G\ub9cc 6\ud68c\ucc28\ub294 \uac19\uc740 \uae30\uc900\uc5d0 \uac78\ub9b0 \ubb38\uc7a5 \ub450\u001b[96G\uac1c\ub97c,\r\u001b[4C\u001b[1B7\ud68c\ucc28\ub294 \uac19\uc740 \uae30\uc900\uc5d0\uc11c\u001b[27G\ube60\uc9c4\u001b[32G\ud56d\ubaa9 \ub450 \uac1c\ub97c \ud568\uaed8 \uace0\ucce4\uc2b5\ub2c8\ub2e4.\u001b[62G2\u001b[69G \ub123\uc740 '\uc758\uc57d\ud488\uc774 \uc544\ub2d9\ub2c8\ub2e4'\u001b[K\r\u001b[4C\u001b[1B\ubb38\uad6c\ub3c4\u001b[12G\ud544\uc218 \uc815\ubcf4\u001b[22G\ub2e4\uc12f\u001b[27G\uac00\uc9c0\u001b[32G\uc911 \ud558\ub098\uc785\ub2c8\ub2e4.\u001b[47G\ub2e4\ub9cc\u001b[52G\uadf8\u001b[55G\uae30\uc900\uc740\u001b[62G7\ud68c\ucc28\uc5d0\uc11c\uc57c\u001b[74G\ud1b5\uacfc\ud588\uc73c\ub2c8,\u001b[86G\uac01\u001b[89G\ud68c\ucc28\uc758\u001b[96G\uc810\uc218\r\u001b[2C\u001b[1B \u001b[5G\ubcc0\ud654\ub294 \uadf8 \ud68c\ucc28\uc5d0 \uace0\uce5c\u001b[27G\uae30\uc900 \ub54c\ubb38\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\uac19\uc774 \uc624\ub978 trust \uc810\uc218:\u001b[22m 6~7\ud68c\ucc28\uc5d0 \uc778\uc815 \ubb38\uad6c\uc640\u001b[49G\uc8fc\uc758\uc0ac\ud56d\uc774\u001b[60G\ub4e4\uc5b4\uac00\uba74\uc11c\u001b[71G'\ud655\uc778\ud560\u001b[79G\uc218\u001b[82G\uc788\ub294\u001b[87G\uadfc\uac70(trust)'\r\u001b[2C\u001b[1B \u001b[5G\uc810\uc218\ub3c4 1.9\uc5d0\uc11c 4.0\uc73c\ub85c \ud568\uaed8 \uc62c\ub790\uc2b5\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\ud310\uc815 \ud655\uc2e0\ub3c4\uac00 \ub192\uc9c0 \uc54a\uc740 \uae30\uc900:\u001b[22m \uac8c\uc774\ud2b8\ub294 2\ud68c\ucc28\uc5d0 \uc900\uc218 \ud655\ub960\u001b[62G58\u001b[65G\ub85c \uaca8\uc6b0 \ub118\uc5c8\uace0,\u001b[81G\uc9c0\uae08\uc740\u001b[88G81%\uc785\ub2c8\ub2e4.\r\u001b[2C\u001b[1B \u001b[5G\ucd5c\uc885 \ud68c\ucc28\uc5d0\uc11c\ub3c4 \ud6a8\uacfc \ud45c\ud604\uacfc \ud544\uc218 \uc815\ubcf4 \ud310\uc815\uc740 \uc900\uc218 \ud655\ub960\uc774 81% \uc815\ub3c4\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m\uaf2d \ud655\uc778\ud574 \uc8fc\uc138\uc694:\u001b[23G\u001b[22m\uc12d\ucde8 \uc2dc \uc8fc\uc758\uc0ac\ud56d \ubb38\uad6c(\"\uc9c8\ud658\uc774 \uc788\uac70\ub098 \uc758\uc57d\ud488\uc744 \ubcf5\uc6a9 \uc911\uc778 \ubd84, \uc784\uc0b0\ubd80\u00b7\uc218\uc720\ubd80\ub294\u001b[99G\u2026\r\u001b[4C\u001b[1B\uc0c1\ub2f4\")\ub294 \ube0c\ub9ac\ud504\uc5d0 \uc5c6\uc5b4\uc11c \uc77c\ubc18\uc801\uc778 \uc608\uc2dc\ub85c \uc81c\uac00 \uc4f4\u001b[54G\uac83\uc785\ub2c8\ub2e4. \uc62c\ub9ac\uae30 \uc804\uc5d0 \uc2e4\uc81c \uc81c\ud488 \ud45c\uc2dc\uc0ac\ud56d\uc73c\ub85c\r\u001b[4C\u001b[1B\ubc14\uafd4\u001b[10G\uc8fc\uc138\uc694.\u001b[18G\ub8e8\ube0c\ub9ad\u001b[25G\uc8fc\uc11d\uc5d0\u001b[32G\uc801\ud78c\u001b[37G\ub300\ub85c\u001b[42G\ubc95\ub839\u001b[47G\uc6d0\ubb38\uacfc\u001b[54G\uc790\uc728\uc2ec\uc758\u001b[63G\uae30\uc900\ub3c4\u001b[70G\ud655\uc778\uc774\u001b[77G\ud544\uc694\ud569\ub2c8\ub2e4.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[39m \u001b[38;5;246mBaked for 1m 29s\u001b[20G\u00b7 done\u001b[27G5:48 AM\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[38C\u001b[2B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
