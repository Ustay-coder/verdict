[64.7523, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u00b7\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[64.9333, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[30G\u001b[22mline\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;231m\u001b[2m 21 \u001b[22m \"\uc54c\ub78c \ub9de\ucdb0\ub450\uace0 3\uc8fc\uc9f8 \ube60\uc9d0\uc5c6\uc774 \uba39\uace0 \uc788\uc5b4\uc694.\" (52\uc138, \uc790\uc601\uc5c5)\r\u001b[5C\u001b[1B\u001b[2m 22 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 23 \u001b[22m ## \uc774\uac83\ub9cc\uc740 \uaf2d \uc54c\ub824\ub4dc\ub824\uc694\r\u001b[1B\u001b[39m     \u001b[38;5;167m\u001b[48;5;52m 24 -\u001b[38;5;231m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \ub2f9\ub1e8\ub97c \uce58\ub8cc\ud558\uba70, \uafb8\uc900\ud788 \ub4dc\uc2dc\uba74 \ud608\ub2f9\uc57d\uc744 \ub04a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.         \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 24 +\u001b[38;5;231m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \uc9c8\ubcd1\uc758 \uc608\ubc29 \ubc0f \uce58\ub8cc\ub97c \uc704\ud55c \uc758\uc57d\ud488\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ubcf5\uc6a9 \uc911\uc778 \uc57d\uc774 \uc788\ub2e4 \r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;231m\uba74 \uc784\uc758\ub85c \uc911\ub2e8\ud558\uc9c0 \ub9c8\uc138\uc694.                                                         \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m5\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 26 \u001b[22m ## \uad6c\ub9e4 \uc548\ub0b4\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 27 \u001b[22m 29,000\uc6d0 / 30\uc77c\ubd84. \uccab \uad6c\ub9e4 \uc2dc \ubb34\ub8cc\ubc30\uc1a1.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\uac8c\uc774\ud2b8\ub294 \ud1b5\uacfc\ud588\uc9c0\ub9cc \uc900\uc218 \ud655\ub960\uc774 58%\ub85c \uc544\uc2ac\uc544\uc2ac\ud569\ub2c8\ub2e4.\u001b[57G\ub2e4\uc74c\uc740\u001b[64G\uc804\ubb38\uac00\u001b[71G\ucd94\ucc9c(no_endorsement)\uc744\r\u001b[2C\u001b[1B\uace0\uce69\ub2c8\ub2e4.\u001b[13G\uc57d\uc0ac\u001b[18G\ucd94\ucc9c\u001b[23G\uc139\uc158\uc744\u001b[30G\uc0ad\uc81c\ud569\ub2c8\ub2e4.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mCalling verdict\u2026\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[64.9687, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m 25 \u001b[22m \r\u001b[5C\u001b[1B\u001b[2m 26 \u001b[22m ## \uad6c\ub9e4 \uc548\ub0b4\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 27 \u001b[22m 29,000\uc6d0 / 30\uc77c\ubd84. \uccab \uad6c\ub9e4 \uc2dc \ubb34\ub8cc\ubc30\uc1a1.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\uac8c\uc774\ud2b8\ub294 \ud1b5\uacfc\ud588\uc9c0\ub9cc \uc900\uc218 \ud655\ub960\uc774 58%\ub85c\u001b[41G\uc544\uc2ac\uc544\uc2ac\ud569\ub2c8\ub2e4.\u001b[57G\ub2e4\uc74c\uc740\u001b[64G\uc804\ubb38\uac00\u001b[71G\ucd94\ucc9c(no_endorsement)\uc744\r\u001b[2C\u001b[1B\uace0\uce69\ub2c8\ub2e4. \uc57d\uc0ac \ucd94\ucc9c \uc139\uc158\uc744 \uc0ad\uc81c\ud569\ub2c8\ub2e4.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(detail.md)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mRemoved\u001b[14G\u001b[1m3\u001b[16G\u001b[22mlines\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m 9\u001b[11G\u001b[22m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \ubc14\ub098\ubc14\uc78e \ucd94\ucd9c\ubb3c(\ucf54\ub85c\uc194\uc0b0 1.3mg)\ub85c \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4.\r\u001b[6C\u001b[1B\u001b[2m10\u001b[11G\u001b[22m\uba39\uae30\ub9cc \ud558\uba74 \ud608\ub2f9\uc774\u001b[30G\ub69d\u001b[33G\ub5a8\uc5b4\uc9c0\uace0, \ud6a8\uacfc\ub294 100% \ubcf4\uc7a5\ud569\ub2c8\ub2e4.\r\u001b[5C\u001b[1B\u001b[2m 11 \u001b[22m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;167m\u001b[48;5;52m 12 -\u001b[38;5;231m## \uc57d\uc0ac\uac00 \uba3c\uc800 \uad8c\ud569\ub2c8\ub2e4                                                            \r\u001b[5C\u001b[1B\u001b[38;5;167m 13 -\u001b[38;5;231m\"\ud608\ub2f9\uc774 \uac71\uc815\ub418\ub294 \ubd84\ub4e4\uaed8 \uc57d\uad6d\uc5d0\uc11c\ub3c4 \uac00\uc7a5 \uba3c\uc800 \uad8c\ud558\ub294 \uc81c\ud488\uc785\ub2c8\ub2e4.\" (\ud604\uc9c1 \uc57d\uc0ac \uae40OO)  \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m 14 -\u001b[38;5;231m                                                                                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;231m\u001b[2m 12 \u001b[22m ## \ud558\ub8e8 \ud55c \uc54c, \uc2dd\uc0ac \uc804\uc5d0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 13 \u001b[22m 1\uc77c 1\ud68c 1\uc815. \ubb3c\uacfc \ud568\uaed8 \uc2dd\uc0ac 30\ubd84 \uc804\uc5d0 \ub4dc\uc138\uc694.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 14 \u001b[22m \uc791\uc740 \uc815\uc81c\ub77c \uc0bc\ud0a4\uae30 \ud3b8\ud558\uace0, \ud55c \ud1b5\uc73c\ub85c 30\uc77c\uc744 \ucc59\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[64.9984, "o", "\u001b[?25l\u001b[H\r\u001b[12C\u001b[23B\u001b[38;5;216m\u2026\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
