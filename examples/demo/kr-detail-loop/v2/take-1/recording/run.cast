[58.4764, "o", "\u001b[?25l\u001b[H\r\u001b[18B\u001b[38;5;246m \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[58.5171, "o", "\u001b[?25l\u001b[H\u001b[48;5;237m  \u001b[38;5;231m\ub118\uc9c0 \ubabb\ud558\uba74, \uc2e4\ud328\ud55c \uae30\uc900 \uc911 \ud558\ub098\ub9cc \uace8\ub77c \uadf8 \ubd80\ubd84\ub9cc \uace0\uce5c \ub4a4 \ub2e4\uc2dc evaluate \ud574. \uac8c\uc774\ud2b8\uc5d0 \uac78\ub838\uc73c\uba74 \u001b[39m    \r\u001b[1B  \u001b[38;5;231m\uac8c\uc774\ud2b8\ubd80\ud130 \uace0\uccd0. \ubb34\uc5c7\uc774 \uc810\uc218\ub97c \ubc14\uafe8\ub294\uc9c0 \ubcf4\uc774\ub3c4\ub85d \ud55c \ud68c\ucc28\uc5d0 \ud55c \uac00\uc9c0\ub9cc \uace0\uccd0. \ud1b5\uacfc\ud558\uba74 \uba48\ucdb0. \u001b[39m        \r\u001b[1B  \u001b[38;5;231m\ub9c8\uc9c0\ub9c9\uc5d0 \uc2ec\uc0ac \uae30\ub85d \ud45c(\ud68c\ucc28, \uc810\uc218, \ub4f1\uae09, \ubc14\uafbc \ub0b4\uc6a9)\ub97c \ud55c\uad6d\uc5b4\ub85c \ucd9c\ub825\ud574.\u001b[39m                             \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRead \u001b[1m3\u001b[22m files, called verdict \u001b[1m2\u001b[22m times \r\u001b[2B\u001b[38;5;231m\u25cf\u001b[39m 1\ud68c\ucc28\ub294 \uc9c8\ubcd1 \uac8c\uc774\ud2b8\uc5d0 \uac78\ub824 0\uc810\uc774\ub77c, \uba3c\uc800 24\ud589\uc758 \ub2f9\ub1e8 \uce58\ub8cc \ubb38\uad6c\ub97c \uc758\uc57d\ud488\uc774 \uc544\ub2c8\ub77c\ub294 \uc548\ub0b4\ub85c\u001b[K\r\u001b[1B  \uace0\uce58\uaca0\uc2b5\ub2c8\ub2e4.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[39m \u001b[1mUpdate\u001b[22m(detail.md)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 21 \u001b[22m \"\uc54c\ub78c \ub9de\ucdb0\ub450\uace0 3\uc8fc\uc9f8 \ube60\uc9d0\uc5c6\uc774 \uba39\uace0 \uc788\uc5b4\uc694.\" (52\uc138, \uc790\uc601\uc5c5)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 22 \u001b[22m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;231m\u001b[2m 23 \u001b[22m ## \uc774\uac83\ub9cc\uc740 \uaf2d \uc54c\ub824\ub4dc\ub824\uc694\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 24 -\u001b[38;5;231m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \ub2f9\ub1e8\ub97c \uce58\ub8cc\ud558\uba70, \uafb8\uc900\ud788 \ub4dc\uc2dc\uba74 \ud608\ub2f9\uc57d\uc744 \ub04a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 24 +\u001b[38;5;231m\uc232\uacb0 \ubc14\ub098\ubc14 \uc815\uc740 \uc9c8\ubcd1\uc758 \uc608\ubc29 \ubc0f \uce58\ub8cc\ub97c \uc704\ud55c \uc758\uc57d\ud488\uc774 \uc544\ub2d9\ub2c8\ub2e4. \ubcf5\uc6a9 \uc911\uc778 \uc57d\uc774 \uc788\ub2e4 \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;231m\uba74 \uc784\uc758\ub85c \uc911\ub2e8\ud558\uc9c0 \ub9c8\uc138\uc694.                                                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 25 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 26 \u001b[22m ## \uad6c\ub9e4 \uc548\ub0b4\r\u001b[5C\u001b[1B\u001b[2m 27 \u001b[22m 29,000\uc6d0 / 30\uc77c\ubd84. \uccab \uad6c\ub9e4 \uc2dc \ubb34\ub8cc\ubc30\uc1a1.\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mCalling\u001b[11Gverdict\u2026\u001b[30;1H\u001b[28;3H\u001b[?25h"]
