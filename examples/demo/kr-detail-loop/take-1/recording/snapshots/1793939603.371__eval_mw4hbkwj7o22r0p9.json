{
  "id": "eval_mw4hbkwj7o22r0p9",
  "rubricId": "rub_mw4hbffkkv7nvdef",
  "rubric": {
    "name": "상세페이지 심사",
    "version": "1",
    "description": "이 상세페이지를 그대로 스마트스토어에 올려도 되는가?",
    "context": "건강기능식품 상세페이지 문구를 브랜드 브리프에 비추어 심사합니다. 브리프에는 타깃 고객, 인정된 기능성 표현,\n절대 쓰면 안 되는 표현이 적혀 있습니다. 상세페이지 문구만 판단하세요.\n",
    "language": "ko",
    "scale": {
      "type": "numeric",
      "min": 1,
      "max": 5
    },
    "judges": {
      "jev": {
        "type": "decision",
        "provider": "typesafe",
        "model": "jev-latest",
        "onLowConfidence": "accept",
        "escalateTo": []
      },
      "clef": {
        "type": "decision",
        "provider": "cloudflare",
        "model": "@cf/cloudflare/clef",
        "onLowConfidence": "accept",
        "escalateTo": []
      }
    },
    "defaultJudge": {
      "type": "ref",
      "ref": "jev"
    },
    "criteria": [
      {
        "id": "empathy",
        "name": "타깃 고객의 상황에서 시작한다",
        "weight": 3,
        "levels": [
          {
            "value": 1,
            "label": "무관",
            "description": "브리프의 타깃과 상관없는 이야기로 시작한다"
          },
          {
            "value": 3,
            "label": "일부",
            "description": "타깃을 언급하지만 그들의 구체적인 상황은 없다"
          },
          {
            "value": 5,
            "label": "정확",
            "description": "브리프의 타깃이 겪는 구체적인 상황에서 시작한다"
          }
        ],
        "inputs": [
          "page",
          "brief"
        ],
        "optional": false
      },
      {
        "id": "specifics",
        "name": "제품 정보가 구체적이다",
        "weight": 2,
        "levels": [
          {
            "value": 1,
            "label": "모호",
            "description": "원료, 섭취법, 용량, 가격 같은 정보가 없다"
          },
          {
            "value": 3,
            "label": "일부",
            "description": "일부 정보만 있다"
          },
          {
            "value": 5,
            "label": "구체적",
            "description": "원료, 섭취법, 용량, 가격, 인정된 기능성이 모두 분명하다"
          }
        ],
        "inputs": [
          "page",
          "brief"
        ],
        "optional": false
      },
      {
        "id": "trust",
        "name": "믿을 근거가 있다",
        "weight": 1,
        "levels": [
          {
            "value": 1,
            "label": "없음",
            "description": "주장만 있고 근거가 없다"
          },
          {
            "value": 3,
            "label": "약함",
            "description": "근거가 하나 있지만 약하다"
          },
          {
            "value": 5,
            "label": "분명",
            "description": "인정 원료, 섭취 후기, 주의사항처럼 확인할 수 있는 근거가 있다"
          }
        ],
        "inputs": [
          "page"
        ],
        "optional": false
      },
      {
        "id": "ad_compliant",
        "name": "광고 기준 준수",
        "weight": 0,
        "scale": {
          "type": "binary",
          "labels": [
            "위반",
            "준수"
          ]
        },
        "anchors": {
          "위반": "질병 예방·치료 효능, 의약품 오인, 효과 보장처럼 브리프의 금지 표현이 하나라도 있다",
          "준수": "모든 표현이 브리프의 인정된 기능성 범위 안에 있고, 금지 표현이 없다"
        },
        "judge": {
          "type": "ref",
          "ref": "clef"
        },
        "inputs": [
          "page",
          "brief"
        ],
        "optional": false
      }
    ],
    "aggregation": {
      "method": "formula",
      "formula": "ad_compliant_n < 0.5 ? 0 : (empathy_n * 3 + specifics_n * 2 + trust_n) / 6",
      "rater": "mean",
      "normalize": [
        0,
        100
      ],
      "missing": "exclude",
      "gates": [
        {
          "criterion": "ad_compliant",
          "min": 1,
          "message": "광고 기준 위반: 브리프의 금지 표현(질병 치료·의약품 오인·효과 보장)이 있습니다"
        }
      ],
      "grades": [
        {
          "label": "게시 가능",
          "min": 75
        },
        {
          "label": "수정 필요",
          "min": 50
        },
        {
          "label": "반려",
          "min": 0
        }
      ],
      "passThreshold": 75,
      "precision": 0
    },
