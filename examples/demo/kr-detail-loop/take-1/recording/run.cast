[64.2368, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B  \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[1B  \u2502                 \uae30\uc900                 \u2502   1\ud68c\ucc28    \u2502   2\ud68c\ucc28    \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 \ud0c0\uae43 \uace0\uac1d\uc758 \uc0c1\ud669\uc5d0\uc11c \uc2dc\uc791 (\uac00\uc911\uce58 3)\u001b[42G\u2502\u001b[44G4.86\u001b[55G\u2502\u001b[57G4.86\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B \u001b[3G\u2502 \uc81c\ud488 \uc815\ubcf4 \uad6c\uccb4\uc131 (\uac00\uc911\uce58\u001b[30G2)          \u2502 4\u001b[46G98     \u001b[54G \u2502 4.98       \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5G\ubbff\uc744\u001b[10G\uadfc\uac70\u001b[15G(\uac00\uc911\uce58\u001b[23G1)\u001b[42G\u2502\u001b[44G4.50\u001b[55G\u2502\u001b[57G4.88\u001b[68G\u2502\r\u001b[1B \u001b[3G\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B  \u2502 \uad11\uace0 \uae30\uc900 \uc900\uc218\u001b[20G(\ud1b5\uacfc \uc870\uac74)   \u001b[42G\u2502\u001b[44G\uc704\ubc18\u001b[49G(98%)\u001b[55G\u2502\u001b[57G\uc900\uc218\u001b[62G(95%)\u001b[68G\u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m1\ud68c\ucc28 \uc9c0\uc801 \uc0ac\ud56d:\u001b[22m \uad11\uace0 \uae30\uc900 \uc900\uc218\ub9cc\u001b[39G\uac78\ub838\uace0\u001b[46G\ub098\uba38\uc9c0\u001b[53G\uae30\uc900\uc740\u001b[60G\ubaa8\ub450\u001b[65G4.5\uc810\u001b[71G\uc774\uc0c1\uc774\uc5c8\uc2b5\ub2c8\ub2e4.\u001b[87GVerdict\ub294\r\u001b[4C\u001b[1B\ubb38\uc7a5\uc744 \uc9da\uc9c0 \uc54a\uace0 \uc704\ubc18 \ud655\ub960\ub9cc \uc54c\ub824\uc92c\uc2b5\ub2c8\ub2e4. \uadf8\ub798\uc11c \ube0c\ub9ac\ud504\uc758 \uae08\uc9c0 \ud45c\ud604(\"\ub2f9\ub1e8 \uce58\ub8cc\", \"\uc57d\uc744 \ub04a\uc744\u001b[98G\uc218\r\u001b[4C\u001b[1B\uc788\ub2e4\")\uacfc \uc9c1\uc811 \uacb9\uce58\ub294 19\ud589\uc744 \uc6d0\uc778\uc73c\ub85c \ud310\ub2e8\ud558\uace0 \uadf8 \ubb38\uc7a5\ub9cc \ubc14\uafe8\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \ubb38\uc7a5, \uc81c\ubaa9, \uad6c\uc870\ub294\r\u001b[4C\u001b[1B\uadf8\ub300\ub85c\uc785\ub2c8\ub2e4.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1m2\ud68c\ucc28 \uacb0\uacfc:\u001b[17G\u001b[22m\uc704\ubc18\u001b[22G\ud310\uc815\uc774\u001b[29G\ud480\ub9ac\uba74\uc11c\u001b[38G\uc810\uc218\uac00\u001b[45G98\uc810\uc774\u001b[52G\ub410\uc2b5\ub2c8\ub2e4.\u001b[62G\uadfc\uac70\u001b[67G\uc810\uc218\ub3c4\u001b[74G4.50\uc5d0\uc11c\u001b[83G4.88\ub85c\u001b[90G\uc62c\ub790\uc2b5\ub2c8\ub2e4.\r\u001b[4C\u001b[1B\uc0c8 \ubb38\uc7a5\uc774 \uc8fc\uc758\uc0ac\ud56d\u001b[24G\uc5ed\ud560\uc744\u001b[31G\ud558\uae30\u001b[36G\ub54c\ubb38\uc73c\ub85c\u001b[45G\ubcf4\uc785\ub2c8\ub2e4.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\uc791\uc5c5\uc740\u001b[10G\u001b[38;5;153m/root/detail-page\u001b[28G\u001b[39m\ud3f4\ub354\u001b[33G\uc548\uc5d0\uc11c\ub9cc\u001b[42G\ud588\uace0,\u001b[48G\uc218\uc815\ud55c\u001b[55G\ud30c\uc77c\uc740\u001b[62G\u001b[38;5;153mdetail.md\u001b[72G\u001b[39m\ud558\ub098\uc785\ub2c8\ub2e4.\u001b[84GVerdict\ub294\u001b[94G\uc790\ub3d9\r\u001b[1B \u001b[3G\ud310\uc815\uc774\ub77c \ubc95\uc801 \uac80\ud1a0\ub97c\u001b[24G\ub300\uc2e0\ud558\uc9c0\u001b[33G\uc54a\uc2b5\ub2c8\ub2e4.\u001b[43G\uc62c\ub9ac\uae30\u001b[50G\uc804\uc5d0\u001b[55G\uac74\uac15\uae30\ub2a5\uc2dd\ud488\u001b[68G\ud45c\uc2dc\u00b7\uad11\uace0\u001b[78G\uaddc\uc815\uc744\u001b[85G\ub2e4\uc2dc\u001b[90G\ud55c\ubc88\r\u001b[2C\u001b[1B\ud655\uc778\ud558\uc2dc\uae38\u001b[14G\uad8c\ud569\ub2c8\ub2e4.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[39m \u001b[38;5;246mCrunched for 45s\u001b[20G\u00b7 done\u001b[27G4:33 AM\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[38C\u001b[2B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
