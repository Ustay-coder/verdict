c\u001b[95Gis\u001b[98Gfar\r\u001b[2C\u001b[1Bstricter\u001b[12Gthan\u001b[17Gthe\u001b[21Ghumans'\u001b[29Gwhat-and-why\u001b[42Gstandard.\u001b[52GI'm\u001b[56Greplacing\u001b[66Gthe\u001b[70Gstyle\u001b[76Gcriterion\u001b[86Gwith\u001b[91Gone\u001b[95Gbased\r\u001b[2C\u001b[1Bon the codebook's\u001b[21Gdefinition.\r\u001b[2B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(com\u001b[14Git-review.yaml)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mCalling verdict\u2026\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[50.9266, "o", "\u001b[?25l\u001b[H\r\u001b[20B\u001b[38;5;246m \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[50.9738, "o", "\u001b[?25l\u001b[H\u001b[38;5;231m\u25cf\u001b[39m Check 1 came back at 57%, with all 41 disagreements going the same way, so the style rubric is far\r\u001b[1B  stricter than the humans' what-and-why standard. I'm replacing the style criterion with one based\u001b[K\r\u001b[1B  on the codebook's definition.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[39m \u001b[1mUpdate\u001b[22m(commit-review.yaml)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 12 \u001b[22m     \u001b[38;5;148minputs:\u001b[38;5;231m [\u001b[38;5;186mmessage\u001b[38;5;231m]\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 13 \u001b[22m     \u001b[38;5;148mscale:\u001b[38;5;231m { \u001b[38;5;148mtype:\u001b[38;5;231m \u001b[38;5;186mbinary\u001b[38;5;231m, \u001b[38;5;148mlabels:\u001b[38;5;231m [\u001b[38;5;141mno\u001b[38;5;231m, \u001b[38;5;141myes\u001b[38;5;231m] }\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 14 \u001b[22m     \u001b[38;5;148manchors:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 15 -\u001b[38;5;231m      no: \"Breaks the usual rules: subject over 50 characters, not capitalised, end\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;167m\u001b[48;5;52m    -\u001b[38;5;231ms with a period, not in the imperative mood, no blank line before the body, or the \r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mbody isn't wrapped at 72 characters\"                                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m 16 -\u001b[38;5;231m      yes: \"Follows the usual rules: a short capitalised subject in the imperative \r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mmood with no period, a blank line, then a wrapped body\"                            \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;77m\u001b[48;5;22m 15 +\u001b[38;5;231m      \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message does not both summarise what was changed and give the reason\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;186m for the change. Formatting and style (length, capitalisation, mood, wrapping) do n\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mot matter.\"\u001b[38;5;231m                                                                        \u001b[95G\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m 16 +\u001b[38;5;231m      \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message summarises what was changed and also gives the reason for t\u001b[95G\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mhe change. Formatting and style (length, capitalisation, mood, wrapping) do not mat\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;186mter.\"\u001b[38;5;231m                                                                              \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;231m\u001b[2m 17 \u001b[22m \u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186mweighted_mean\u001b[38;5;231m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[51.0018, "o", "\u001b[?25l\u001b[H\r\u001b[22B\u001b[38;5;246m\u25cf\r\u001b[2B\u001b[38;5;174m*\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
