[116.2088, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 22 -\u001b[38;5;231m      no: \"The message only names a problem, bug, symptom or goal (e.g. 'fix X bug'\r\u001b[6C\u001b[1B\u001b[38;5;167m  \u001b[11G\u001b[38;5;231m,\u001b[13G'X\u001b[16Gis nullable', 'make Y less fl\u001b[46Gky') without saying what change was made to\u001b[90Gthe \r\u001b[10C\u001b[1Bcode, \u001b[18Go a read\u001b[27Gr cannot\u001b[36Gte\u001b[39Gl what was actually\u001b[59Gdone\" \u001b[66G    \u001b[71G      \u001b[78G   \u001b[82G    \u001b[87G  \u001b[90G   \r\u001b[6C\u001b[1B\u001b[38;5;167m23\u001b[11G\u001b[38;5;231m     \u001b[17Gyes:\u001b[22G\"The message summarises\u001b[46Gthe\u001b[50Gcode change: the\u001b[67Gobject\u001b[74Gof\u001b[77Gchange,\u001b[85Ga\u001b[87Glist\u001b[92Gof\r\u001b[6C\u001b[1B\u001b[38;5;167m  \u001b[12G\u001b[38;5;231mchanges, before/after,\u001b[35Gwhat the changed code now does,\u001b[68Gr how\u001b[74Gthe change\u001b[85Gwork\u001b[90G\"\u001b[92G  \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 22 +\u001b[38;5;231m      \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message describes only the problem, symptom or desired outcome and n\r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;186mever says which change was made\"\u001b[38;5;231m                                                   \r\u001b[6C\u001b[1B\u001b[38;5;77m23\u001b[11G\u001b[38;5;231m      \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message says what was changed, even briefly: naming the object of c\r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;186mhange and the kind of change (add, remove, update, rename, polish, fix in a named f\r\u001b[10C\u001b[1Bile or component) is enough.\u001b[40GA chang\u001b[48G list, a before/aft\u001b[68Gr\u001b[70Gc\u001b[72Gntrast, what\u001b[85Gthe co\u001b[92Ge \r\u001b[10C\u001b[1Bnow\u001b[15Gdoes, or how the\u001b[32Gchan\u001b[37Ge works also count\"\u001b[38;5;231m                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 24 \u001b[22m \u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186mmin\u001b[38;5;231m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mCheck\u001b[9G7\u001b[11Greached\u001b[19G78%\u001b[23Gagreement,\u001b[34Gwith\u001b[39Gmost\u001b[44Gremaining\u001b[54Gmisses\u001b[61Gbeing\u001b[67Ghumans-good\u001b[79Gmessages\u001b[88Gthe\u001b[92Gcombined\r\u001b[1B \u001b[3G\u001b[38;5;153mgood\u001b[39m crit\u001b[13Grion rejects for lacking a reason. I'm replacing \u001b[38;5;153mgood\u001b[67G\u001b[39mwith a pure\u001b[79G\u001b[38;5;153mwhy\u001b[39m criterion that\u001b[K\r\u001b[2C\u001b[1Buses\u001b[8Gthe codebook's list of reason\u001b[38Gtyp\u001b[42Gs next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRead \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[39m \u001b[1mUpdate\u001b[22m(commit-review.yaml)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[116.2696, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m 12 \u001b[22m     \u001b[38;5;148minputs:\u001b[38;5;231m [\u001b[38;5;186mmessage\u001b[38;5;231m]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 13 \u001b[22m     \u001b[38;5;148mscale:\u001b[38;5;231m { \u001b[38;5;148mtype:\u001b[38;5;231m \u001b[38;5;186mbinary\u001b[38;5;231m, \u001b[38;5;148mlabels:\u001b[38;5;231m [\u001b[38;5;141mno\u001b[38;5;231m, \u001b[38;5;141myes\u001b[38;5;231m] }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 14 \u001b[22m     \u001b[38;5;148manchors:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m15\u001b[17G\u001b[38;5;231mno: \"The mes\u001b[30Gage does not both summarise what\u001b[63Gwas\u001b[67Gchanged and giv\u001b[83G the reas\u001b[93Gn\r\u001b[11C\u001b[1Bfor the change. A m\u001b[32Gssage \u001b[39Ghat only d\u001b[50Gscrib\u001b[56Gs the problem\u001b[70G(the why) without saying\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231m what change was made has no what. Formatting and style (length, capitalisation, mo\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mod, wrapping) do not matter.\"                                                      \r\u001b[5C\u001b[1B\u001b[38;5;167m 16 -\u001b[38;5;231m      yes: \"The message summarises what was changed and also gives the reason for t\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mhe change. A reference to the issue or pull request the change belongs to (for exam\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mple an issue number or PR number) counts as the reason. Formatting and style (lengt\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mh, capitalisation, mood, wrapping) do not matter.\"                                 \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 15 +\u001b[38;5;231m      \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"Nothing in the message, stated or implied, gives a reason for the change\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;186m and there is no issue or pull request reference\"\u001b[38;5;231m                                  \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 16 +\u001b[38;5;231m      \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message gives a reason, in any one of these ways: describes the iss\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;186mue (error scenario, shortcoming, issue report); states the objective or goal; illus\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mtrates a requirement (something out of date, environment changed, a usage need); im\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mplies necessity (follows a convention, brings an improvement or benefit, relates to\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186m an implemented feature or prior commit); or references the issue or pull request t\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;186mhe change belongs to\"\u001b[38;5;231m                                                              \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;231m\u001b[2m 17 \u001b[22m   - \u001b[38;5;148mid:\u001b[38;5;231m \u001b[38;5;186mwhat\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 18 \u001b[22m     \u001b[38;5;148mname:\u001b[38;5;231m \u001b[38;5;186mSays\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[38;5;231m \u001b[38;5;186mchanged\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 19 \u001b[22m     \u001b[38;5;148minputs:\u001b[38;5;231m [\u001b[38;5;186mmessage\u001b[38;5;231m]\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[116.3027, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u2722\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[117.4235, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;231m\u001b[2m4\u001b[15G\u001b[22m\u001b[38;5;148ma\u001b[17Gchors:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 15 -\u001b[38;5;231m      no: \"The message does not both summarise what was changed and give the reason\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231m for the change. A message that only describes the problem (the why) without saying\r\u001b[6C\u001b[1B\u001b[38;5;167m  \u001b[12G\u001b[38;5;231mwhat\u001b[17Gchange was made has no what. Formatting and style\u001b[67G(le\u001b[72Gth, capitalisation, mo\r\u001b[10C\u001b[1Bod, wrapping) do\u001b[28Gnot matt\u001b[37Gr.\"  \u001b[43G    \u001b[48G         \u001b[58G   \u001b[62G       \u001b[70G    \u001b[75G    \u001b[80G       \u001b[88G      \r\u001b[6C\u001b[1B\u001b[38;5;167m16\u001b[12G\u001b[38;5;231m    \u001b[17Gyes: \"The message \u001b[36Gummarises\u001b[46Gwhat was ch\u001b[59Gged and\u001b[67Ga\u001b[69Gso gives the reason for t\r\u001b[10C\u001b[1Bhe change. A reference \u001b[35Go the\u001b[41Gissue\u001b[47Gor\u001b[50Gpull\u001b[55Grequest\u001b[63Gthe\u001b[67Gchange\u001b[74Gbelongs\u001b[82Gto\u001b[85G(for\u001b[90Gexam\r\u001b[6C\u001b[1B\u001b[38;5;167m  \u001b[11G\u001b[38;5;231mple\u001b[15Gan i\u001b[20Gsue numb\u001b[29Gr or PR number) coun\u001b[50Gs \u001b[55Gt\u001b[57Ge r\u001b[61Gaso\u001b[65G.\u001b[67GFormatting\u001b[78Gand\u001b[82Gstyle (leng\r\u001b[11C\u001b[1B,\u001b[15Gapitalisation, mood, wrapp\u001b[42Gng) d\u001b[48G not matter.\" \u001b[63G   \u001b[67G      \u001b[74G       \u001b[82G  \u001b[85G    \u001b[90G    \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 15 +\u001b[38;5;231m      \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"Nothing in the message, stated or implied, gives a reason for the change\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;186m and there is no issue or pull request reference\"\u001b[38;5;231m                                  \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[17G\u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message giv\u001b[40G \u001b[42G rea\u001b[47Gon, in any one of\u001b[65Gthese\u001b[71Gways: describes the iss\r\u001b[10C\u001b[1Bue (erro\u001b[20G scenario, shortcoming, issue\u001b[52Gpo\u001b[55Gt); states the objective or goal; illus\r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;186mtrates a requirement (something out of date, environment changed, a usage need); im\r\u001b[10C\u001b[1Bplies nece\u001b[22Gsity (follows a co\u001b[41Gvention,\u001b[50Gbrings an improvem\u001b[69Gnt or ben\u001b[79Gfit, re\u001b[87Gates to\r\u001b[10C\u001b[1B an implem\u001b[22Gnted f\u001b[29Ga\u001b[31Gure or prior commit); or\u001b[56Grefe\u001b[61Ge\u001b[63Gc\u001b[65Gs the issue\u001b[77Gor pull\u001b[85Gr\u001b[87Gquest t\r\u001b[10C\u001b[1Bhe cha\u001b[18Gge belongs to\"\u001b[38;5;231m                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 17 \u001b[22m   - \u001b[38;5;148mid:\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 18 \u001b[22m     \u001b[38;5;148mname:\u001b[38;5;231m \u001b[38;5;186mSays\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[38;5;231m \u001b[38;5;186mchanged\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m9\u001b[13G\u001b[22m \u001b[16G\u001b[38;5;148mnputs:\u001b[38;5;231m [\u001b[38;5;186mmessage\u001b[38;5;231m]\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mCalling verdict\u2026\u001b[K\r\u001b[2B\u001b[38;5;174m\u273d\u001b[21G\u001b[38;5;246m3\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
