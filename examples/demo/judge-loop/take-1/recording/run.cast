[82.6973, "o", "\u001b[?25l\u001b[H \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m 15 -\u001b[38;5;231m      no: \"The message does not both summarise what was changed and give the reason\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;167m\u001b[48;5;52m    -\u001b[38;5;231m for the change. Formatting and style (length, capitalisation, mood, wrapping) do n\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mot matter.\"                                                                        \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 15 +\u001b[38;5;231m      \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message does not both summarise what was changed and give the reason\r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186m for the change. \u001b[48;5;28mA message that only describes the problem (the why) without saying\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186m\u001b[48;5;28m what change was made has no what. \u001b[48;5;22mFormatting and style (length, capitalisation, mo\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;186mod, wrapping) do not matter.\"\u001b[38;5;231m                                                      \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m6\u001b[15G\u001b[22m  \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message summarises what was changed and also gives the reason for t\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mhe change. A reference to the issue or pull request the change belongs to (for exam\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mple an issue number or PR number) counts as the reason. Formatting and style (lengt\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mh, capitalisation, mood, wrapping) do not matter.\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 17 \u001b[22m \u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186mweighted_mean\u001b[38;5;231m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mCheck 4 scored 77%, so adding that sentence to the combined criterion made no difference. I'm\r\u001b[2C\u001b[1Bsplitting out a dedicated \u001b[38;5;153mwhat\u001b[39m criterion next, after first changing aggregation to \u001b[38;5;153mmin\u001b[39m so both\r\u001b[2C\u001b[1Bcriteria must pass.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(commit-review.yaml)\u001b[K\r\u001b[4B\u001b[38;5;174m\u00b7\u001b[15G \u001b[25G\u001b[38;5;246m3\u001b[36G)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[82.7357, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mCheck 4 scored 77%, so adding that sentence to the combined criterion made no difference. I'm\r\u001b[2C\u001b[1Bsplitting out a dedicated \u001b[38;5;153mwhat\u001b[39m criterion next, after first changing aggregation to \u001b[38;5;153mmin\u001b[39m so both\r\u001b[2C\u001b[1Bcriteria must pass.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(commit-review.yaml)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m14\u001b[11G\u001b[22m    \u001b[38;5;148manchors:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m15\u001b[11G\u001b[22m      \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message does not both summarise what was changed and give the reason\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;186m for the change. A message that only describes the problem (the why) without saying\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186m what change was made has no what. Formatting and style (length, capitalisation, mo\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mod, wrapping) do not matter.\"\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 16 \u001b[22m       \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message summarises what was changed and also gives the reason for t\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mhe change. A reference to the issue or pull request the change belongs to (for exam\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mple an issue number or PR number) counts as the reason. Formatting and style (lengt\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mh, capitalisation, mood, wrapping) do not matter.\"\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 17 -\u001b[38;5;231maggregation: { method: weighted_mean, passThreshold: 50 }                          \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 17 +\u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186m\u001b[48;5;28mmin\u001b[38;5;231m\u001b[48;5;22m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }                                    \r\u001b[35C\u001b[4B\u001b[49m\u001b[38;5;246m \u00b7 thought for 11s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
