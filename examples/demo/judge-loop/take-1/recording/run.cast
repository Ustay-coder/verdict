;5;186mot matter.\"\u001b[38;5;231m                                                                        \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[17G\u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The me\u001b[30Gsage summarises what w\u001b[53Gs changed\u001b[63Gand\u001b[67Galso gives the reason for t\r\u001b[10C\u001b[1Bhe change. Formatting and style\u001b[43G(length, capitalisa\u001b[63Gion, mo\u001b[71Gd\u001b[74Gwrapping) do not mat\r\u001b[10C\u001b[1Bter.\"\u001b[38;5;231m      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 17 \u001b[22m \u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186mweighted_mean\u001b[38;5;231m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mCheck\u001b[9G2:\u001b[12G64%.\u001b[17GMost\u001b[22Gof\u001b[25Gthe\u001b[29Gremaining\u001b[39Gmisses\u001b[46Gthat\u001b[51Ghumans\u001b[58Gcalled\u001b[65Ggood\u001b[70Gcarry\u001b[76Gonly\u001b[81Gan\u001b[84Gissue\u001b[90Gor\u001b[93GPR\r\u001b[1B \u001b[3Greference (\"Closes\u001b[22Ggh-\u2026\",\u001b[29G\"(#3110)\").\u001b[41GChange\u001b[48G2:\u001b[51Gapply\u001b[57Gthe\u001b[61Gcodebook's\u001b[72G\"Issue\u001b[79Glink\u001b[84Gor\u001b[87GPR\u001b[90Glink\"\u001b[96Grow.\u001b[30;1H\u001b[28;3H\u001b[?25h"]
