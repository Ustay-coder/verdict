[102.1811, "o", "\u001b[?25l\u001b[H\u001b[11G\u001b[38;5;186mple an issu\u001b[24Gnumber or PR\u001b[38Gumber) counts as the reason.\u001b[67GForma\u001b[73Gting and style (lengt\r\u001b[10C\u001b[1Bh, capitalisati\u001b[27Gn, mood, w\u001b[38Gapping) do not matter.\"\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 17 +\u001b[38;5;231m  - \u001b[38;5;148mid:\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[38;5;231m                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 18 +\u001b[38;5;231m    \u001b[38;5;148mname:\u001b[38;5;231m \u001b[38;5;186mSays\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[38;5;231m \u001b[38;5;186mchanged\u001b[38;5;231m                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 19 +\u001b[38;5;231m    \u001b[38;5;148minputs:\u001b[38;5;231m [\u001b[38;5;186mmessage\u001b[38;5;231m]                                                              \r\u001b[5C\u001b[1B\u001b[38;5;77m 20 +\u001b[38;5;231m    \u001b[38;5;148mscale:\u001b[38;5;231m { \u001b[38;5;148mtype:\u001b[38;5;231m \u001b[38;5;186mbinary\u001b[38;5;231m, \u001b[38;5;148mlabels:\u001b[38;5;231m [\u001b[38;5;141mno\u001b[38;5;231m, \u001b[38;5;141myes\u001b[38;5;231m] }                                     \r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[13G\u001b[38;5;231m \u001b[15G\u001b[38;5;148manchors:\r\u001b[6C\u001b[1B\u001b[38;5;77m22\u001b[15G\u001b[38;5;231m  \u001b[38;5;148mno\u001b[21G\u001b[38;5;186m\"The message only names a problem, bug, symptom or goal (e.g. 'fix X bug'\r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;186m, 'X is nullable', 'make Y less flaky') without saying what change was made to the \r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;186mcode, so a reader cannot tell what was actually done\"\r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[15G\u001b[38;5;231m  \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message summarises the code change: the object of change, a list of\r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;186m changes, before/after, what the changed code now does, or how the change works\"\u001b[38;5;231m   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 24 \u001b[22m \u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186mmin\u001b[38;5;231m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mCheck 6 came in at 76% overall, and the new \u001b[38;5;153mwhat\u001b[39m criterion\u001b[62Gagrees\u001b[69Gwith\u001b[74Gthe\u001b[78Ghumans'\u001b[86Gwhat\u001b[91Glabel\u001b[97Gonly\r\u001b[2C\u001b[1B71%\u001b[7Gof\u001b[10Gthe\u001b[14Gtime.\u001b[20GI'm\u001b[24Gswitching\u001b[34Gthose\u001b[40Ganchors\u001b[48Gto\u001b[51Gthe\u001b[55Gcodebook's\u001b[66G\"object\u001b[74Gof\u001b[77Gchange\"\u001b[85Greading\u001b[93Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(commit-review.yaml)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mCalling v\u001b[13Grd\u001b[16Gct\u2026\u001b[20G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[102.1984, "o", "\u001b[?25l\u001b[H\r\u001b[19B\u001b[38;5;246m \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[102.2388, "o", "\u001b[?25l\u001b[H\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mCheck 6 came in at 76% overall, and the new \u001b[38;5;153mwhat\u001b[39m criterion agrees with the humans' what label\u001b[97Gonly\r\u001b[2C\u001b[1B71% of the time. I'm switching those anchors to the codebook's\u001b[66G\"object\u001b[74Gof\u001b[77Gchange\"\u001b[85Greading\u001b[93Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(commit-review.yaml)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 19 \u001b[22m     \u001b[38;5;148minputs:\u001b[38;5;231m [\u001b[38;5;186mmessage\u001b[38;5;231m]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 20 \u001b[22m     \u001b[38;5;148mscale:\u001b[38;5;231m { \u001b[38;5;148mtype:\u001b[38;5;231m \u001b[38;5;186mbinary\u001b[38;5;231m, \u001b[38;5;148mlabels:\u001b[38;5;231m [\u001b[38;5;141mno\u001b[38;5;231m, \u001b[38;5;141myes\u001b[38;5;231m] }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 21 \u001b[22m     \u001b[38;5;148manchors:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 22 -\u001b[38;5;231m      no: \"The message only names a problem, bug, symptom or goal (e.g. 'fix X bug'\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231m, 'X is nullable', 'make Y less flaky') without saying what change was made to the \r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mcode, so a reader cannot tell what was actually done\"                              \r\u001b[5C\u001b[1B\u001b[38;5;167m 23 -\u001b[38;5;231m      yes: \"The message summarises the code change: the object of change, a list of\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231m changes, before/after, what the changed code now does, or how the change works\"   \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 22 +\u001b[38;5;231m      \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message describes only the problem, symptom or desired outcome and n\r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mever says which change was made\"\u001b[38;5;231m                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m 23 +\u001b[38;5;231m      \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message says what was changed, even briefly: naming the object of c\r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mhange and the kind of change (add, remove, update, rename, polish, fix in a named f\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mile or component) is enough. A change list, a before/after contrast, what the code \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mnow does, or how the change works also count\"\u001b[38;5;231m                                      \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;231m\u001b[2m 24 \u001b[22m \u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186mmin\u001b[38;5;231m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[102.2666, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u2722\u001b[29G\u001b[38;5;246m1\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
