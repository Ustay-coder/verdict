[59.068, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mCheck 2: 64%. Most of the remaining misses that humans called good carry only an issue or PR\r\u001b[2C\u001b[1Breference (\"Closes gh-\u2026\", \"(#3110)\"). Change 2: apply the codebook's \"Issue link or PR link\"\u001b[96Grow.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(commit-review.yaml)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 13 \u001b[22m     \u001b[38;5;148mscale:\u001b[38;5;231m { \u001b[38;5;148mtype:\u001b[38;5;231m \u001b[38;5;186mbinary\u001b[38;5;231m, \u001b[38;5;148mlabels:\u001b[38;5;231m [\u001b[38;5;141mno\u001b[38;5;231m, \u001b[38;5;141myes\u001b[38;5;231m] }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 14 \u001b[22m     \u001b[38;5;148manchors:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 15 \u001b[22m       \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message does not both summarise what was changed and give the reason\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186m for the change. Formatting and style (length, capitalisation, mood, wrapping) do n\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mot matter.\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 16 -\u001b[38;5;231m      yes: \"The message summarises what was changed and also gives the reason for t\r\u001b[5C\u001b[1B\u001b[38;5;167m    -\u001b[38;5;231mhe change. Formatting and style (length, capitalisation, mood, wrapping) do not mat\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;167m\u001b[48;5;52m    -\u001b[38;5;231mter.\"                                    