[88.0845, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m*\u001b[18G\u001b[38;5;246m4\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[88.1317, "o", "\u001b[?25l\u001b[H\u001b[3Gsplitting\u001b[13Gout\u001b[17Ga\u001b[19Gdedicated\u001b[29G\u001b[38;5;153mwhat\u001b[34G\u001b[39mcriterion\u001b[44Gnext,\u001b[50Gafter\u001b[56Gfirst\u001b[62Gchanging\u001b[71Gaggregation\u001b[83Gto\u001b[86G\u001b[38;5;153mmin\u001b[90G\u001b[39mso\u001b[93Gboth\r\u001b[2C\u001b[1Bcriteria must pass.\r\u001b[2B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(commit-review.yaml)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;231m\u001b[2m 14 \u001b[22m     \u001b[38;5;148manchors:\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 15 \u001b[22m       \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message does not both summarise what was changed and give the reason\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186m for the change. A message that only describes the problem (the why) without saying\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186m what change was made has no what. Formatting and style (length, capitalisation, mo\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;186mod, wrapping) do not matter.\"\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m6\u001b[17G\u001b[22m\u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The me\u001b[30Gsage summarises what w\u001b[53Gs changed\u001b[63Gand\u001b[67Galso gives the reason for t\r\u001b[10C\u001b[1Bhe change. A r\u001b[26Gference to the issue or pull request the change belongs \u001b[83Go (for exam\r\u001b[10C\u001b[1Bple an issu\u001b[24Gnumber or PR\u001b[38Gumber) counts as the reason.\u001b[67GForma\u001b[73Gting and style (lengt\r\u001b[10C\u001b[1Bh, capitalisati\u001b[27Gn, mood, w\u001b[38Gapping) do not matter.\"\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 17 -\u001b[38;5;231maggregation: { method: weighted_mean, passThreshold: 50 }                          \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 17 +\u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186m\u001b[48;5;28mmin\u001b[38;5;231m\u001b[48;5;22m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }                                    \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mThe check came back at 78%, roughly the same as before, so the 77\u201378 swing is just judge variance\r\u001b[2C\u001b[1Bof\u001b[6Gabout\u001b[12G\u00b11.\u001b[16GI'm\u001b[20Gadding\u001b[27Ga\u001b[29Gdedicated\u001b[39G\u001b[38;5;153mwhat\u001b[44G\u001b[39mcriterion\u001b[54Gnext,\u001b[60Gso\u001b[63Gunder\u001b[69G\u001b[38;5;153mmin\u001b[73G\u001b[39ma\u001b[75Gmessage\u001b[83Gmust\u001b[88Gpass\u001b[93Gboth\r\u001b[1B \u001b[3Gcriteria.\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
