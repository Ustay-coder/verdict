[89.8345, "o", "\u001b[?25l\u001b[H\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;231m\u001b[2m 14 \u001b[22m     \u001b[38;5;148manchors:\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 15 \u001b[22m       \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message does not both summarise what was changed and give the reason\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186m for the change. A message that only describes the problem (the why) without saying\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186m what change was made has no what. Formatting and style (length, capitalisation, mo\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;186mod, wrapping) do not matter.\"\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m6\u001b[17G\u001b[22m\u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The me\u001b[30Gsage summarises what w\u001b[53Gs changed\u001b[63Gand\u001b[67Galso gives the reason for t\r\u001b[10C\u001b[1Bhe change. A r\u001b[26Gference to the issue or pull request the change belongs \u001b[83Go (for exam\r\u001b[10C\u001b[1Bple an issu\u001b[24Gnumber or PR\u001b[38Gumber) counts as the reason.\u001b[67GForma\u001b[73Gting and style (lengt\r\u001b[10C\u001b[1Bh, capitalisati\u001b[27Gn, mood, w\u001b[38Gapping) do not matter.\"\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 17 -\u001b[38;5;231maggregation: { method: weighted_mean, passThreshold: 50 }                          \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 17 +\u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186m\u001b[48;5;28mmin\u001b[38;5;231m\u001b[48;5;22m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }                                    \r\u001b[5C\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mThe check came back at 78%, roughly the same as before, so the 77\u201378 swing is just judge variance\r\u001b[2C\u001b[1Bof\u001b[6Gabout\u001b[12G\u00b11.\u001b[16GI'm\u001b[20Gadding\u001b[27Ga\u001b[29Gdedicated\u001b[39G\u001b[38;5;153mwhat\u001b[44G\u001b[39mcriterion\u001b[54Gnext,\u001b[60Gso\u001b[63Gunder\u001b[69G\u001b[38;5;153mmin\u001b[73G\u001b[39ma\u001b[75Gmessage\u001b[83Gmust\u001b[88Gpass\u001b[93Gboth\r\u001b[2C\u001b[1Bcriteria.\u001b[K\r\u001b[2B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b[11Gommit-review.yaml)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mCalling verdict\u2026\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[89.8516, "o", "\u001b[?25l\u001b[H\r\u001b[19B\u001b[38;5;246m \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[89.8802, "o", "\u001b[?25l\u001b[H     \u001b[38;5;231m\u001b[2m 14 \u001b[22m     \u001b[38;5;148manchors:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m5\u001b[15G\u001b[22m  \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message does not both summarise what was changed and give the reason\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;186m for the change. A messag\u001b[37G tha\u001b[43Gonly\u001b[48Gdescribes\u001b[58Gt\u001b[60Ge problem (the\u001b[75Gwhy) without\u001b[88Gsaying\r\u001b[11C\u001b[1Bwhat change was\u001b[28Gmad\u001b[32G h\u001b[35Gs no what. Formatt\u001b[54Gng and style (length, capitalisa\u001b[87Gion, mo\r\u001b[10C\u001b[1Bod, wrapping) do\u001b[28Gnot matter.\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m16\u001b[11G\u001b[22m      \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message summarises what was changed and also gives the reason for t\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;186mhe change. A r\u001b[26Gference to the \u001b[43Gsue or pull\u001b[55Grequest\u001b[63Gthe\u001b[67Gchange b\u001b[76Glongs\u001b[82Gto (for exam\r\u001b[10C\u001b[1Bple an issue\u001b[24Gnumber or\u001b[34GPR\u001b[37Gnumber) counts as\u001b[55Gthe reason.\u001b[67GFormatting and\u001b[82Gstyle (l\u001b[91Gngt\r\u001b[10C\u001b[1Bh, c\u001b[16Gpitalisation, m\u001b[32God, wrapping) do not ma\u001b[56Gt\u001b[58Gr.\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 17 +\u001b[38;5;231m  - \u001b[38;5;148mid:\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[38;5;231m                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 18 +\u001b[38;5;231m    \u001b[38;5;148mname:\u001b[38;5;231m \u001b[38;5;186mSays\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[38;5;231m \u001b[38;5;186mchanged\u001b[38;5;231m                                                        \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[11G\u001b[38;5;231m    \u001b[38;5;148minputs:\u001b[38;5;231m [\u001b[38;5;186mmessage\u001b[38;5;231m] \u001b[34G                   \u001b[54G  \u001b[57G \r\u001b[5C\u001b[1B\u001b[38;5;77m 20 +\u001b[38;5;231m    \u001b[38;5;148mscale:\u001b[38;5;231m { \u001b[38;5;148mtype:\u001b[38;5;231m \u001b[38;5;186mbinary\u001b[38;5;231m, \u001b[38;5;148mlabels:\u001b[38;5;231m [\u001b[38;5;141mno\u001b[38;5;231m, \u001b[38;5;141myes\u001b[38;5;231m] }                                     \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;5;77m\u001b[48;5;22m 21 +\u001b[38;5;231m    \u001b[38;5;148manchors:\u001b[38;5;231m                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 22 +\u001b[38;5;231m      \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message only names a problem, bug, symptom or goal (e.g. 'fix X bug'\r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186m, 'X is nullable', 'make Y less flaky') without saying what change was made to the \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;5;77m\u001b[48;5;22m    +\u001b[38;5;186mcode, so a reader cannot tell what was actually done\"\u001b[38;5;231m                              \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;77m\u001b[48;5;22m 23 +\u001b[38;5;231m      \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The message summarises the code change: the object of change, a list of\r\u001b[5C\u001b[1B\u001b[38;5;77m    +\u001b[38;5;186m changes, before/after, what the changed code now does, or how the change works\"\u001b[38;5;231m   \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;231m\u001b[2m 24 \u001b[22m \u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186mmin\u001b[38;5;231m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[89.9096, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;246m\u25cf\r\u001b[2B\u001b[38;5;174m\u2736\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[90.3389, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u00b7\u001b[3G\u001b[38;5;180mKerfuffling\u2026\u001b[18G\u001b[38;5;246m6\u001b[25G4\u001b[27G0\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
