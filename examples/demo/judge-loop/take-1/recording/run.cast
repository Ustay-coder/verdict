[100.3208, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;186m what change was made has no what. Formatting and style (length, capitalisation, mo\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;186mod, wrapping) do not matt\u001b[37Gr.\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m16\u001b[11G\u001b[22m      \u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"Th\u001b[26G message summarises what was chang\u001b[61Gd and also gives the reason for t\r\u001b[10C\u001b[1Bhe change. A\u001b[24Greference to\u001b[37Gthe issue \u001b[49G pull request th\u001b[67Gcha\u001b[72Ge belongs to (for exam\r\u001b[10C\u001b[1Bple\u001b[15Gan issue number or PR number) counts as the reason. Formatting and style (lengt\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m  \u001b[11G\u001b[22m\u001b[38;5;186mh, capitalisation, mood, wrapp\u001b[42Gng)\u001b[46Gdo not matter.\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 17 +\u001b[38;5;231m  - \u001b[38;5;148mid:\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[38;5;231m                                                                       \r\u001b[5C\u001b[1B\u001b[38;5;77m 18 +\u001b[38;5;231m    \u001b[38;5;148mname:\u001b[38;5;231m \u001b[38;5;186mSays\u001b[38;5;231m \u001b[38;5;186mwhat\u001b[38;5;231m \u001b[38;5;186mchanged\u001b[38;5;231m                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 19 +\u001b[38;5;231m    \u001b[38;5;148minputs:\u001b[38;5;231m [\u001b[38;5;186mmessage\u001b[38;5;231m]                                                              \r\u001b[6C\u001b[1B\u001b[38;5;77m20\u001b[13G\u001b[38;5;231m \u001b[15G\u001b[38;5;148mscale:\u001b[38;5;231m {\u001b[24G\u001b[38;5;148mtype:\u001b[30G\u001b[38;5;186mbinary\u001b[38;5;231m,\u001b[38G\u001b[38;5;148mlabels:\u001b[46G\u001b[38;5;231m[\u001b[38;5;141mno\u001b[38;5;231m,\u001b[51G\u001b[38;5;141myes\u001b[38;5;231m]\u001b[56G}\r\u001b[6C\u001b[1B\u001b[38;5;77m21\u001b[15G\u001b[38;5;148manchors:\u001b[38;5;231m  \u001b[26G    \u001b[31G       \r\u001b[6C\u001b[1B\u001b[38;5;77m22\u001b[15G\u001b[38;5;231m  \u001b[38;5;148mno:\u001b[38;5;231m \u001b[38;5;186m\"The message only names a problem, bug, symptom or goal (e.g. 'fix X bug'\r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;186m, 'X is nullable', 'make Y less flaky') without saying what change was made to the \r\u001b[6C\u001b[1B\u001b[38;5;77m  \u001b[11G\u001b[38;5;186mcode, so a reader cannot tell what was actually done\"\r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[17G\u001b[38;5;148myes:\u001b[38;5;231m \u001b[38;5;186m\"The me\u001b[30Gsage summarises the code change: the object of\u001b[77Gchange, a list of\r\u001b[10C\u001b[1B changes, befor\u001b[27G/after, what the changed code now does, or how th\u001b[78Gchange works\"\u001b[38;5;231m   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 24 \u001b[22m \u001b[38;5;148maggregation:\u001b[38;5;231m { \u001b[38;5;148mmethod:\u001b[38;5;231m \u001b[38;5;186mmin\u001b[38;5;231m, \u001b[38;5;148mpassThreshold:\u001b[38;5;231m \u001b[38;5;141m50\u001b[38;5;231m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mCheck\u001b[9G6\u001b[11Gcame\u001b[16Gin\u001b[19Gat\u001b[22G76%\u001b[26Goverall,\u001b[35Gand\u001b[39Gthe\u001b[43Gnew\u001b[47G\u001b[38;5;153mwhat\u001b[52G\u001b[39mcriterion\u001b[62Gagrees\u001b[69Gwith\u001b[74Gthe\u001b[78Ghumans'\u001b[86Gwhat\u001b[91Glabel\u001b[97Gonly\r\u001b[1B \u001b[3G71% of th\u001b[13G t\u001b[16Gme.\u001b[20GI'm\u001b[24Gswitching\u001b[34Gthose\u001b[40Ganchors\u001b[48Gto\u001b[51Gthe\u001b[55Gcodebook's\u001b[66G\"object\u001b[74Gof\u001b[77Gchange\"\u001b[85Greading\u001b[93Gnext.\r\u001b[28C\u001b[2B\u001b[38;5;246m8\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[100.3344, "o", "\u001b[?25l\u001b[H\r\u001b[40C\u001b[23B\u001b[38;5;246mthought for 6s)\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
