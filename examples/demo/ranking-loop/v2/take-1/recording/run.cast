[105.0837, "o", "\u001b[?25l\u001b[H\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m12\u001b[15G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m  4 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m  5 \u001b[22m Using an IoT sensor and SMS, Tidewatch delivers alerts within seconds of a reading.\r\u001b[7C\u001b[1B\u001b[2m6\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;5;77m\u001b[48;5;22m  7 +\u001b[38;5;231m## Built at the hackathon vs. before                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m  8 +\u001b[38;5;231m                                                                                   \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[11G\u001b[38;5;231mBuilt by\u001b[20Gour t\u001b[26Gam of 3 during\u001b[41Gthe 36-hour\u001b[53Ghackathon:\r\u001b[6C\u001b[1B\u001b[38;5;77m10\u001b[11G\u001b[38;5;231m-\u001b[13GSMS\u001b[17Galert\u001b[23Gservice\u001b[31G(FastAPI\u001b[40G+\u001b[42GTwilio)\r\u001b[6C\u001b[1B\u001b[38;5;77m11\u001b[11G\u001b[38;5;231m- threshold rule that needs 2\u001b[41Greadings in\u001b[53Ga row     \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[13G\u001b[38;5;231mmap\u001b[17Gdashboard of sensor readings    \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[13G\u001b[38;5;231m3D-printed sensor enclosure\u001b[41G        \u001b[50G  \u001b[53G \u001b[55G   \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[11G\u001b[38;5;231m \u001b[13G   \u001b[17G         \u001b[27G  \u001b[30G      \u001b[37G        \r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[11G\u001b[38;5;231mExisted before the event:    \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[11G\u001b[38;5;231m-\u001b[13Gultrasonic\u001b[24Gsensor\u001b[31Gfirmware\u001b[40Gfrom\u001b[45Gour\u001b[49Gearlier\u001b[57Gopen-source\u001b[69Guniversity\u001b[80Gproject\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[11G\u001b[38;5;231m- ESP32\u001b[20Goard and s\u001b[31Gnsor,\u001b[37Gbought\u001b[44Gbefore\u001b[51Gthe\u001b[55Gevent\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[11G\u001b[38;5;231m \u001b[13G          \u001b[24G      \u001b[31G        \u001b[40G    \u001b[45G   \u001b[49G       \u001b[57G           \u001b[69G          \u001b[80G       \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 19 \u001b[22m We are passionate about making streets safer, and we want to keep building Tidewatc\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m h.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mScore 32. Round 5 fixes \u001b[28Gnly\u001b[32G\u001b[38;5;153mai_credited\u001b[39m:\u001b[K\r\u001b[2C\u001b[2B\u001b[38;5;174mComposin\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[105.1117, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m*\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
