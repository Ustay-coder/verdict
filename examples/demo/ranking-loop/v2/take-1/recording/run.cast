[97.4757, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m 1 \u001b[22m # Tidewatch\r\u001b[5C\u001b[1B\u001b[2m 2 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m 3 -\u001b[38;5;231m\ud83c\udf0a Street-level flood warnings.                                                     \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;77m\u001b[48;5;22m 3 +\u001b[38;5;231mTidewatch texts residents of streets next to small creeks and storm drains when thei\r\u001b[5C\u001b[1B\u001b[38;5;77m   +\u001b[38;5;231mr street is about to flood. A water-level sensor on the storm drain sends an SMS to \r\u001b[5C\u001b[1B\u001b[38;5;77m   +\u001b[38;5;231mnearby residents when the water rises past a threshold.                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 4 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 5 -\u001b[38;5;231mTidewatch is a flood early-warning prototype. A water-level sensor on a storm drain \r\u001b[5C\u001b[1B\u001b[38;5;167m   -\u001b[38;5;231msends a text message when the water rises past a threshold.                         \r\u001b[5C\u001b[1B\u001b[38;5;167m 6 -\u001b[38;5;231m                                                                                    \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m5\u001b[10G\u001b[22mUsing an IoT sensor and SMS, Tidewatch delivers alerts within seconds of a reading.\r\u001b[5C\u001b[1B\u001b[2m 6 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 7 \u001b[22m We are passionate about making streets safer, and we want to keep building Tidewatch\r\u001b[5C\u001b[1B\u001b[2m   \u001b[22m .\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mScore went\u001b[14Gto\u001b[17G22\u001b[20Gand\u001b[24Grank\u001b[29Gto\u001b[32G3,\u001b[35Gwhich\u001b[41Gfits\u001b[46G\u001b[38;5;153mwhat_for_whom\u001b[60G\u001b[39mpassing.\u001b[69GRound\u001b[75G4\u001b[77Gfixes\u001b[83Gonly\u001b[88G\u001b[38;5;153mbuilt_during\u001b[39m:\r\u001b[2B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(entries/tidewatch.md)\r\u001b[2B\u001b[38;5;246m \u001b[3G\u001b[39mCalling verdict\u2026\u001b[20G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[97.4907, "o", "\u001b[?25l\u001b[H\r\u001b[19B\u001b[38;5;246m \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[97.513, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(entries/tidewatch.md)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m12\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m  4 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m  5 \u001b[22m Using an IoT sensor and SMS, Tidewatch delivers alerts within seconds of a reading.\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m  7 +\u001b[38;5;231m## Built at the hackathon vs. before                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m  8 +\u001b[38;5;231m                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m  9 +\u001b[38;5;231mBuilt by our team of 3 during the 36-hour hackathon:                               \r\u001b[5C\u001b[1B\u001b[38;5;77m 10 +\u001b[38;5;231m- SMS alert service (FastAPI + Twilio)                                             \r\u001b[5C\u001b[1B\u001b[38;5;77m 11 +\u001b[38;5;231m- threshold rule that needs 2 readings in a row                                    \r\u001b[5C\u001b[1B\u001b[38;5;77m 12 +\u001b[38;5;231m- map dashboard of sensor readings                                                 \r\u001b[5C\u001b[1B\u001b[38;5;77m 13 +\u001b[38;5;231m- 3D-printed sensor enclosure                                                      \r\u001b[5C\u001b[1B\u001b[38;5;77m 14 +\u001b[38;5;231m                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m 15 +\u001b[38;5;231mExisted before the event:                                                          \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;5;77m\u001b[48;5;22m 16 +\u001b[38;5;231m- ultrasonic sensor firmware from our earlier open-source university project       \r\u001b[5C\u001b[1B\u001b[38;5;77m 17 +\u001b[38;5;231m- ESP32 board and sensor, bought before the event                                  \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m 18 +\u001b[38;5;231m                                                                                   \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 19 \u001b[22m We are passionate about making streets safer, and we want to keep building Tidewatc\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m    \u001b[22m h.\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
