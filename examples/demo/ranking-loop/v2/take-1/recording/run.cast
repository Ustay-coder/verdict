[87.3561, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u273b\u001b[9G\u001b[38;5;216mi\u001b[12G\u001b[38;5;174m\u2026\u001b[16G\u001b[38;5;246m6\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[87.3726, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;167m\u001b[48;5;52m   -\u001b[38;5;231m and could save millions of lives worldwide.                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 5 +\u001b[38;5;231mTidewatch is a flood early-warning prototype. A water-level sensor on a storm drain \r\u001b[5C\u001b[1B\u001b[38;5;77m   +\u001b[38;5;231msends a text message when the water rises past a threshold.                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 6 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m7\u001b[10G\u001b[38;5;231mUsing c\u001b[18Gtting-\u001b[25Gdge IoT and machine learn\u001b[51Gng,\u001b[55GTidewatch\u001b[65Gdelivers\u001b[74Greal-time\u001b[84Galerts\u001b[91Gto\r\u001b[5C\u001b[1B\u001b[38;5;167m   -\u001b[38;5;231manyone, anywhere. It is the future of disaster resilience.                          \r\u001b[6C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m7\u001b[10G\u001b[38;5;231mUsing\u001b[17Gn IoT\u001b[23Gs\u001b[25Gn\u001b[27Gor and SMS, Tidewatch delivers ale\u001b[62Gt\u001b[64G within\u001b[72Gseconds\u001b[80Gof\u001b[83Ga\u001b[85Greading.\r\u001b[6C\u001b[1B\u001b[49m\u001b[2m8\r\u001b[6C\u001b[1B\u001b[22m\u001b[38;5;167m\u001b[48;5;52m9\u001b[10G\u001b[38;5;231mWe are passionate ab\u001b[31Gut making th\u001b[45Gworld safer, and we\u001b[65Gcan't wait to scale Tidewa\u001b[92Gch\r\u001b[9C\u001b[1B gl\u001b[14Gbally.       \u001b[28G  \u001b[31G  \u001b[34G   \u001b[38G      \u001b[45G  \u001b[48G        \u001b[57G           \r\u001b[6C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m9\u001b[10G\u001b[38;5;231mWe are passionate about\u001b[34Gmaking streets\u001b[49Gsafer, and we want to ke\u001b[74Gp building\u001b[85GTidewatch\r\u001b[5C\u001b[1B\u001b[38;5;77m   +\u001b[38;5;231m.                                                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[1m2\u001b[22m times \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mThe gate now passes at an honest 69%, so Tidewatch sits at 10, but all six submission checks\u001b[96Gstill\r\u001b[2C\u001b[1Bfail\u001b[8Gand\u001b[12Gquality\u001b[20G(~0.72)\u001b[28Gwould\u001b[34Gcap\u001b[38Git\u001b[41Gnear\u001b[46G72\u001b[49Ganyway.\u001b[57GRound\u001b[63G3\u001b[65Gwill\u001b[70Gfix\u001b[74Gonly\u001b[79Gthe\u001b[83Gopening,\r\u001b[2C\u001b[1B\u001b[38;5;153mwhat_for_whom\u001b[39m.\u001b[K\r\u001b[2B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(\u001b[11Gntries/tidew\u001b[25Gch.md)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m \u001b[3G\u001b[39mCalling verdict\u2026\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[87.3882, "o", "\u001b[?25l\u001b[H\r\u001b[19B\u001b[38;5;246m \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[87.4116, "o", "\u001b[?25l\u001b[H\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mThe gate now passes at an honest 69%, so Tidewatch sits at 10, but all six submission checks\u001b[96Gstill\r\u001b[2C\u001b[1Bfail and quality (~0.72) would cap it near 72 anyway. Round 3 will fix only the opening,\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153mwhat_for_whom\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(entries/tidewatch.md)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m3\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 1 \u001b[22m # Tidewatch\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m2\r\u001b[6C\u001b[1B\u001b[22m\u001b[38;5;167m\u001b[48;5;52m3\u001b[10G\u001b[38;5;231m\ud83c\udf0a\u001b[13GStreet-level flood warnings.   \u001b[45G     \u001b[51G      \u001b[58G   \u001b[62G  \u001b[65G     \u001b[71G    \u001b[76G  \u001b[79G     \u001b[85G         \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 3 +\u001b[38;5;231mTidewatch texts residents of streets next to small creeks and storm drains when thei\r\u001b[6C\u001b[1B\u001b[38;5;77m \u001b[10G\u001b[38;5;231mr st\u001b[16Get i\u001b[21G about\u001b[28Gto flood. A wa\u001b[43Ger-level sensor on the storm drain sends an SMS \u001b[92Go \r\u001b[9C\u001b[1Bnearby\u001b[17Gresidents\u001b[27Gwhen\u001b[32Gthe\u001b[36Gwater\u001b[42Grises\u001b[48Gpast\u001b[53Ga\u001b[55Gthreshold.\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 4 \u001b[22m \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;167m\u001b[48;5;52m 5 -\u001b[38;5;231mTidewatch is a flood early-warning prototype. A water-level sensor on a storm drain \r\u001b[5C\u001b[1B\u001b[38;5;167m   -\u001b[38;5;231msends a text message when the water rises past a threshold.                         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m 6 -\u001b[38;5;231m                                                                                    \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;231m\u001b[2m 5 \u001b[22m Using an IoT sensor and SMS, Tidewatch delivers alerts within seconds of a reading.\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;5;231m\u001b[2m 6 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 7 \u001b[22m We are passionate about making streets safer, and we want to keep building Tidewatch\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m   \u001b[22m .\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
