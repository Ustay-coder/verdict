[143.5633, "o", "\u001b[?25l\u001b[H\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m7\u001b[14G\u001b[22mlines\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 28 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 29 \u001b[22m Public repository: https://git.example.org/tidewatch\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 30 \u001b[22m \u001b[12G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 31 +\u001b[38;5;231m## What doesn't work yet                                                           \r\u001b[5C\u001b[1B\u001b[38;5;77m 32 +\u001b[38;5;231m                                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m 33 +\u001b[38;5;231m- one sensor, no mesh yet                                                          \r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[11G\u001b[38;5;231m- a fixe\u001b[20G threshold,\u001b[32Gno forecasting\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[11G\u001b[38;5;231m-\u001b[13Gthe\u001b[17Gbattery\u001b[25Glasts\u001b[31Gabout\u001b[37G2\u001b[39Gdays\r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[13G\u001b[38;5;231mno city permit\u001b[28Gto moun\u001b[37Gsensors\u001b[45Gon\u001b[48Gpublic\u001b[55Gdrains\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[11G\u001b[38;5;231m \u001b[13G \u001b[15G     \u001b[21G          \u001b[32G  \u001b[35G           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 38 \u001b[22m We are passionate about making streets safer, and we want to keep building Tidewatc\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m h.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mIt's\u001b[8Gat\u001b[11G79,\u001b[15Gone\u001b[19Gpoint\u001b[25Gbelow\u001b[31Gthe\u001b[35Gthreshold.\u001b[46GLet\u001b[50Gme\u001b[53Gsee\u001b[57Gwhich\u001b[63Gquality\u001b[71Gcriterion\u001b[81Gis\u001b[84Gweakest.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mCalled verdict \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mImpact\u001b[10Gis\u001b[13Gthe\u001b[17Gweakest\u001b[25Gcriterion\u001b[35Gat\u001b[38G0.74,\u001b[44Gso\u001b[47GRound\u001b[53G9\u001b[55Gadds\u001b[60Ga\u001b[62G\"Why\u001b[67Git\u001b[70Gmatters\"\u001b[79Gsection\u001b[87Gdrawn\u001b[93Gfrom\r\u001b[1B \u001b[3Gf\u001b[5Gcts.json and the\u001b[22Greal\u001b[27Gcreek\u001b[33Gtest\u001b[38Gresults.\r\u001b[28C\u001b[2B\u001b[38;5;246m9\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
