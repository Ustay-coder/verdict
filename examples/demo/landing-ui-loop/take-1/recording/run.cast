[358.1272, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;231m\u001b[2m60\u001b[16G\u001b[22m  <details \u001b[38;5;148mopen\u001b[38;5;231m><summary>How does Tideline avoid false alarms?<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m   \u001b[12G\u001b[22m>+</span></summary><p>Every monitor is checked from 6 regions. You're alerted only\r\u001b[6C\u001b[1B\u001b[2m   \u001b[13G\u001b[22mwhen\u001b[18Gat least\u001b[27G2 of the\u001b[36G \u001b[38Ggree the serv\u001b[52Gc\u001b[54G \u001b[56Gs down, so on\u001b[71Gf\u001b[74Gky network path won'\r\u001b[11C\u001b[1Bt wake you.</p></details>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 561 -\u001b[38;5;231m      <details><summary>Do you charge per user?<span class=\"pm\">+</span></summary>\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231m<p>No. Every paid plan includes unlimited teammates. Pricing is based on how many \r\u001b[6C\u001b[1B\u001b[38;5;167m   \u001b[12G\u001b[38;5;231mmonitors you run and how \u001b[38Gften\u001b[43Gt\u001b[45Gey check.</p></details>                          \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 561 +\u001b[38;5;231m      <details><summary>Do you charge per user?<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>+</span></summary>\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231m<p>No. Pricing is based on how many monitors you run.</p></details>               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 562 \u001b[22m       <details><summary>Can I migrate from my current tool?<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>+</spa\r\u001b[5C\u001b[1B\u001b[2m     \u001b[22m n></summary><p>Yes. Import monitors from a CSV or from most popular uptime tools' \r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22mexport format\u001b[26G. Most teams finish migrating in less \u001b[65Ghan ten mi\u001b[76Gutes.</p></details\r\u001b[11C\u001b[1B>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m563\u001b[12G\u001b[22m      <detail\u001b[26G><summary>What happens when I\u001b[56Ghit my monitor li\u001b[75Gt?<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>\r\u001b[11C\u001b[1B+</span></summary><p>Your existing monitors keep running. We'll ask you to upgrade\r\u001b[6C\u001b[1B\u001b[2m   \u001b[13G\u001b[22mor\u001b[16Garchive a monitor before\u001b[41Gyou add\u001b[49Ganother. We never switch off monitoring witho\r\u001b[11C\u001b[1But war\u001b[19Ging.</p></details>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m564\u001b[13G\u001b[22m  \u001b[16G  <details><summary>Is there\u001b[46Gn API?<span\u001b[58G\u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>+</span></summa\u001b[85Gy><p>Yes.\r\u001b[11C\u001b[1B There's a full REST API, a CLI, and a Terraform provider. Anything you can do in \r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22mthe\u001b[16Gdashbo\u001b[23Grd, yo\u001b[30G c\u001b[33Gn al\u001b[38Go sc\u001b[43Gipt.</p></details>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[358.1471, "o", "\u001b[?25l\u001b[H\r\u001b[21B\u001b[38;5;246m \r\u001b[2C\u001b[2B\u001b[38;5;216mKne\u001b[8G\u001b[38;5;174ming\u001b[18G\u001b[38;5;246m3\u001b[28G7\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[358.1729, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;231m\u001b[2m59\u001b[16G\u001b[22m<div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"faq reveal\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m560\u001b[12G\u001b[22m      <details \u001b[38;5;148mopen\u001b[38;5;231m><summary>How does Tid\u001b[54Gline\u001b[59Gav\u001b[62Gid false alarms?<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\r\u001b[11C\u001b[1B\u001b[38;5;231m>+</sp\u001b[19Gn></summary><p>Every monitor is ch\u001b[54Gcked from\u001b[64G6 regions. You're alerted\u001b[90Gonly\r\u001b[11C\u001b[1B when at least 2 of them agree the service is down, so one flaky network path won'\r\u001b[5C\u001b[1B\u001b[2m     \u001b[22m t wake you.</p></details>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 561 \u001b[22m       <details><summary>Do you charge per user?<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>+</span></summary>\r\u001b[5C\u001b[1B\u001b[2m     \u001b[22m <p>No. Pricing is based on how many monitors you run.</p></details>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 562 -\u001b[38;5;231m      <details><summary>Can I migrate from my current tool?<span class=\"pm\">+</spa\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mn></summary><p>Yes. Import monitors from a CSV or from most popular uptime tools' \r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mexport formats. Most teams finish migrating in less than ten minutes.</p></details\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231m>                                                                                 \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 562 +\u001b[38;5;231m      <details><summary>Can I migrate from my current tool?<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>+</spa\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231mn></summary><p>Yes. Import monitors from a CSV or from most popular uptime tools' \r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231mexport formats.</p></details>                                                     \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m563\u001b[12G\u001b[22m      <details><summary>What happens when I\u001b[56Ghit my monitor limit?<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>\r\u001b[11C\u001b[1B+</span></summary><p>Your existing monitors keep\u001b[61Grunning. We'll ask you to upgrade\r\u001b[11C\u001b[1B or \u001b[18Gchive a monitor before you add another. We never switch off monitoring witho\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22mut\u001b[15Gwarning.</p\u001b[28G/det\u001b[33Gils>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m564\u001b[13G\u001b[22m     <details><summary>Is there\u001b[47G API?<sp\u001b[56Gn \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>+</span></summary><p>Yes.\r\u001b[11C\u001b[1B There's a full REST API, a\u001b[40GCLI, and a Terraform provider. Anything you can do in \r\u001b[5C\u001b[1B\u001b[2m     \u001b[22m the dashboard, you can also script.</p></details>\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 565 \u001b[22m     </div>\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
