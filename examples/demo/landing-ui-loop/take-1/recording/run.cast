01b[1B\u001b[38;5;167m     -\u001b[38;5;231mclass=\"arrow\">\u2192</span></a>                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 376 +\u001b[38;5;231m      <a \u001b[38;5;148mhref\u001b[38;5;231m=\u001b[38;5;186m\"#start\"\u001b[38;5;231m \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"btn btn-primary btn-lg\"\u001b[38;5;231m>Start free <span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"arro\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;186mw\"\u001b[38;5;231m>\u2192</span></a>                                                                   \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m377 \u001b[22m       <a \u001b[38;5;148mhref\u001b[38;5;231m=\u001b[38;5;186m\"#how\"\u001b[38;5;231m \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"btn btn-ghost btn-lg\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m378 \u001b[22m  \u001b[14G      <svg \u001b[38;5;148mwidth\u001b[38;5;231m=\u001b[38;5;186m\"16\"\u001b[38;5;231m \u001b[38;5;148mheight\u001b[38;5;231m=\u001b[38;5;186m\"16\"\u001b[38;5;231m \u001b[38;5;148mviewBox\u001b[38;5;231m=\u001b[38;5;186m\"0 0 24 24\"\u001b[38;5;231m \u001b[38;5;148mfill\u001b[38;5;231m=\u001b[38;5;186m\"currentColor\"\u001b[38;5;231m><path \r\u001b[5C\u001b[1B\u001b[2m     \u001b[22m \u001b[38;5;148md\u001b[38;5;231m=\u001b[38;5;186m\"M8 5v14l11-7z\"\u001b[38;5;231m/></svg> See how it works\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 379 \u001b[22m       </a>\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[458.5826, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;5;231m\u001b[2m7\u001b[11G\u001b[22m@keyframes shimmer{50%{background-posit\u001b[51Gon:100% 0}}\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m78\u001b[11G\u001b[22m.lede{font-\u001b[23Gize:clamp(17px,2vw,20px);color:var(--muted);max-width:620px;margin:0 au\r\u001b[6C\u001b[1B\u001b[2m  \u001b[11G\u001b[22mto 34px}\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m 373 \u001b[22m     <h1 \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"reveal d1\"\u001b[38;5;231m>Uptime and cron-job monitoring for small engineering tea\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m     \u001b[22m ms</h1>\u001b[20G\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;5;231m\u001b[2m4\u001b[17G\u001b[22mp \u001b[38;5;148mclas\u001b[24G\u001b[38;5;231m=\u001b[38;5;186m\"lede reveal d2\"\u001b[38;5;231m>For teams of 2 to 20 engineers\u001b[73Gwho run their own\u001b[91Gs\u001b[93Gr\r\u001b[11C\u001b[1Bvices. Tideline checks your APIs, sites, and cron jobs from 6 regions every 30 sec\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22monds, and alerts you only when at\u001b[46Gl\u001b[49Gst\u001b[52G2 regi\u001b[59Gns agree something is\u001b[81Gdown.</p>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m375\u001b[12G\u001b[22m    <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"hero-ctas reveal d3\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 376 -\u001b[38;5;231m      <a href=\"#start\" class=\"btn btn-primary btn-lg\">Start monitoring free <span \r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mclass=\"arrow\">\u2192</span></a>                                                        \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 376 +\u001b[38;5;231m      <a \u001b[38;5;148mhref\u001b[38;5;231m=\u001b[38;5;186m\"#start\"\u001b[38;5;231m \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"btn btn-primary btn-lg\"\u001b[38;5;231m>Start free <span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"arro\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;186mw\"\u001b[38;5;231m>\u2192</span></a>                                                                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 377 \u001b[22m       <a \u001b[38;5;148mhref\u001b[38;5;231m=\u001b[38;5;186m\"#how\"\u001b[38;5;231m \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"btn btn-ghost btn-lg\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 378 \u001b[22m         <svg \u001b[38;5;148mwidth\u001b[38;5;231m=\u001b[38;5;186m\"16\"\u001b[38;5;231m \u001b[38;5;148mheight\u001b[38;5;231m=\u001b[38;5;186m\"16\"\u001b[38;5;231m \u001b[38;5;148mviewBox\u001b[38;5;231m=\u001b[38;5;186m\"0 0 24 24\"\u001b[38;5;231m \u001b[38;5;148mfill\u001b[38;5;231m=\u001b[38;5;186m\"currentColor\"\u001b[38;5;231m><path \r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22m\u001b[38;5;148md\u001b[38;5;231m=\u001b[38;5;186m\"M8 5v14l11-7z\"\u001b[38;5;231m/></svg> See how it works\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;5;231m\u001b[2m9\u001b[18G\u001b[22m</a>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
