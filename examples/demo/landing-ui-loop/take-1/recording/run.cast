[360.1287, "o", "\u001b[?25l\u001b[H\u001b[7G\u001b[38;5;231m\u001b[2m564\u001b[13G\u001b[22m  \u001b[16G  <details><summary>Is there\u001b[46Gn API?<span\u001b[58G\u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"pm\"\u001b[38;5;231m>+</span></summa\u001b[85Gy><p>Yes.\r\u001b[11C\u001b[1B There's a full REST API, a CLI, and a Terraform provider. Anything you can do in \r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22mthe\u001b[16Gdashbo\u001b[23Grd, yo\u001b[30G c\u001b[33Gn al\u001b[38Go sc\u001b[43Gipt.</p></details>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m565\u001b[13G\u001b[22m   </div>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m 571 \u001b[22m   <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"wrap\"\u001b[38;5;231m>\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 572 \u001b[22m     <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"cta-box reveal\"\u001b[38;5;231m>\r\u001b[8C\u001b[1B\u001b[2m3\u001b[14G\u001b[22m    <h2 \u001b[23G\u001b[38;5;148mtyle\u001b[38;5;231m=\u001b[38;5;186m\"margin-top:14px\"\u001b[38;5;231m>Your next outage is coming. Be the first to know\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22m.</h2>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 574 -\u001b[38;5;231m      <p>Your first 10 monitors are free forever. Upgrade when your team needs mor\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231me.</p>                                                                            \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 574 +\u001b[38;5;231m      <p>The free plan includes 5 monitors. The Team plan is $19 a month for 100 m\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231monitors, with a 14-day trial and no card required.</p>                            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 575 \u001b[22m       <form \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"signup\"\u001b[38;5;231m \u001b[38;5;148mid\u001b[38;5;231m=\u001b[38;5;186m\"signup\"\u001b[38;5;231m \u001b[38;5;148mnovalidate\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 576 \u001b[22m         <label \u001b[38;5;148mfor\u001b[38;5;231m=\u001b[38;5;186m\"email\"\u001b[38;5;231m \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"position:absolute;width:1px;height:1px;overflow:\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m   \u001b[12G\u001b[22m\u001b[38;5;186mhidden;clip:rect(0 0 0 0)\u001b[38G\u001b[38;5;231m>Work email</label>\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;5;231m\u001b[2m7\u001b[21G\u001b[22minput\u001b[27G\u001b[38;5;148mid\u001b[38;5;231m=\u001b[38;5;186m\"email\"\u001b[38;5;231m \u001b[38;5;148mtype\u001b[38;5;231m=\u001b[38;5;186m\"email\"\u001b[38;5;231m \u001b[38;5;148mplaceholder\u001b[38;5;231m=\u001b[38;5;186m\"you@com\u001b[72Gany.com\"\u001b[38;5;231m \u001b[38;5;148mautocomplete\u001b[38;5;231m=\r\u001b[11C\u001b[1B\u001b[38;5;186m\"email\"\u001b[38;5;231m \u001b[38;5;148mrequired\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[K\r\u001b[2B\u001b[38;5;174m*\u001b[28G\u001b[38;5;246m8\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
