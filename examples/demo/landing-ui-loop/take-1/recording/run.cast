79G       \u001b[87G    \u001b[92G  \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 482 +\u001b[38;5;231m        <p>\u001b[48;5;28mEach\u001b[48;5;22m \u001b[48;5;28mjob\u001b[48;5;22m pings \u001b[48;5;28ma\u001b[48;5;22m \u001b[48;5;28munique URL \u001b[48;5;22mwhen it finishes. If \u001b[48;5;28ma\u001b[48;5;22m ping \u001b[48;5;28mis\u001b[48;5;22m \u001b[48;5;28mmissed\u001b[48;5;22m, Tide\r\u001b[6C\u001b[1B\u001b[38;5;77m   \u001b[12G\u001b[38;5;231mline\u001b[17Galerts you\u001b[48;5;28m after a grace period you set\u001b[48;5;22m.</p>\u001b[62G    \u001b[67G   \u001b[71G           \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m83\u001b[32G\u001b[22m\u001b[38;5;186mcode\"\u001b[38;5;231m><span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"c\"\u001b[38;5;231m># end of backup.sh</span>\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 484 -\u001b[38;5;231m<span class=\"k\">curl</span> -fsS <span class=\"s\">https://hb.tideline.dev/</span><s\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mpan class=\"n\">k7f2q</span></div>                                                  \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 484 +\u001b[38;5;231m<span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"k\"\u001b[38;5;231m>curl</span> -fsS <span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"s\"\u001b[38;5;231m>https://hb.tideline.dev/</span><s\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231mpan \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"n\"\u001b[38;5;231m>\u001b[48;5;28myour-job-id\u001b[48;5;22m</span></div>                                            \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m485\u001b[12G\u001b[22m      </article>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 486 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 487 \u001b[22m       <article \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"tile reveal d2\"\u001b[38;5;231m>\u001b[39m\u001b[30;1H\u001b[28;3H\