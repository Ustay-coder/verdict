></svg> See h\u001b[44Gw\u001b[46Git works\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m379\u001b[12G\u001b[22m      </a>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 426 \u001b[22m <section \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"sec\"\u001b[38;5;231m \u001b[38;5;148mid\u001b[38;5;231m=\u001b[38;5;186m\"features\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 427 \u001b[22m   <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"wrap\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 428 \u001b[22m     <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"sec-head reveal\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 429 -\u001b[38;5;231m      <h2>Monitoring without the enterprise overhead.</h2>                        \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 429 +\u001b[38;5;231m      <h2>What Tideline monitors</h2>                                             \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m430\u001b[12G\u001b[22m      <p>Built for teams of 2\u001b[42Gt\u001b[44G 20 engineers who run their own services, and quie\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22mt\u001b[14Gunless something is genuinely wrong.</p>\r\u001b[5C\u001b[1B\u001b[2m 431 \u001b[22m     </div>\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 432 \u001b[22m \u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
