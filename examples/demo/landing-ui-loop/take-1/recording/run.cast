231m</article\u001b[28G  \u001b[31G                                           \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m9\u001b[18G\u001b[22m<article \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"tile wide reveal d1\"\u001b[38;5;231m>\r\u001b[6C\u001b[1B\u001b[2m500\u001b[18G\u001b[22m  <h3>Monitors as code</h3>\r\u001b[6C\u001b[1B\u001b[2m501\u001b[12G\u001b[22m        <p>Keep monitors in a <code \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"font-family:var(--mono);color:var(--tea\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m     \u001b[22m \u001b[38;5;186ml);font-size:14px\"\u001b[38;5;231m>tideline.yml</code> next to your service. Apply them from CI wi\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m     \u001b[22m th our CLI or Terraform provider.</p>\r\u001b[16C\u001b[2B\u001b[38;5;246m9\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[334.5635, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 496 -\u001b[38;5;231m          <span><i style=\"background:#8b5cf6\"></i>Teams</span>                    \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m6\u001b[20G\u001b[22m</div>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 497 \u001b[22m       </article>\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;5;231m\u001b[2m8\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mRemoved\u001b[14G\u001b[1m4\u001b[16G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m 496 \u001b[22m         </div>\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m 497 \u001b[22m       </article>\r\u001b[8C\u001b[1B\u001b[2m8\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 499 -\u001b[38;5;231m      <article class=\"tile wide reveal\">                                          \r\u001b[5C\u001b[1B\u001b[38;5;167m 500 -\u001b[38;5;231m        <h3>SSL and domain expiry warnings</h3>                                   \r\u001b[6C\u001b[1B\u001b[38;5;167m501\u001b[18G\u001b[38;5;231m  <p>You\u001b[27Gget a reminder 30, 14, and\u001b[54G3\u001b[56Gdays\u001b[61Gbefore\u001b[68Ga\u001b[70Gcertificate\u001b[82Gor\u001b[85Gdomain\u001b[92Gla\r\u001b[6C\u001b[1B\u001b[38;5;167m   \u001b[12G\u001b[38;5;231mpses,\u001b[18Gso a forgotten renewal never takes the site\u001b[62Gdown.</p>\r\u001b[8C\u001b[1B\u001b[38;5;167m2\u001b[18G\u001b[38;5;231m</article>  \u001b[31G \u001b[33G        \u001b[42G   \u001b[46G   \u001b[50G   \u001b[54G \u001b[56G    \u001b[61G      \u001b[68G \u001b[70G           \u001b[82G  \u001b[85G      \u001b[92G  \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 499 \u001b[22m       <article \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"tile wide reveal d1\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 500 \u001b[22m         <h3>Monitors as code</h3>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m501\u001b[18G\u001b[22m  <p>Ke\u001b[26Gp monitors in a <code \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"font-family:var(--mono);color:var(--tea\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m   \u001b[12G\u001b[22m\u001b[38;5;186ml);font-size:14px\"\u001b[38;5;231m>tideline.yml</code> next to your service. Apply them from CI wi\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22mth\u001b[15Gour\u001b[19GCLI or Terraform provider.</p>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
