[365.1, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m 602 \u001b[22m     </div>\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 603 -\u001b[38;5;231m    <div class=\"foot-bottom\"><span>\u00a9 2026 Tideline Labs, Inc.</span><span><a href=\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m     -\u001b[38;5;231m\"#\">Privacy</a> \u00b7 <a href=\"#\">Terms</a> \u00b7 <a href=\"#\">Security</a></span></div>   \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;77m\u001b[48;5;22m 603 +\u001b[38;5;231m    <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"foot-bottom\"\u001b[38;5;231m><span>\u00a9 Tideline Labs, Inc.</span><span><a \u001b[38;5;148mhref\u001b[38;5;231m=\u001b[38;5;186m\"#\"\u001b[38;5;231m>P\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231mrivacy</a> \u00b7 <a \u001b[38;5;148mhref\u001b[38;5;231m=\u001b[38;5;186m\"#\"\u001b[38;5;231m>Terms</a> \u00b7 <a \u001b[38;5;148mhref\u001b[38;5;231m=\u001b[38;5;186m\"#\"\u001b[38;5;231m>Security</a></span></div>        \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m604\u001b[13G\u001b[22m </div>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m605\u001b[12G\u001b[22m</footer>\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;5;231m\u001b[2m6\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mThe inline\u001b[14Ggrid\u001b[19Gstyle\u001b[25Gwould\u001b[31Goverride\u001b[40Gthe\u001b[44Gmobile\u001b[51Gbreakpoint,\u001b[63Gso\u001b[66GI'm\u001b[70Gmoving\u001b[77Git\u001b[80Ginto\u001b[85Gthe\u001b[89G\u001b[38;5;153m.plans\u001b[96G\u001b[39mrule:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 525 \u001b[22m       <h2>Simple pricing that doesn't grow per seat.</h2>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 526 \u001b[22m       <p>You pay for monitors, not headcount.</p>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m527\u001b[14G\u001b[22m  </div>\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 528 -\u001b[38;5;231m    <div class=\"plans\" style=\"grid-template-columns:repeat(2,1fr);max-width:760px;\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mmargin:0 auto\">                                                                   \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 528 +\u001b[38;5;231m    <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"plans\"\u001b[38;5;231m>                                                           \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;5;231m\u001b[2m 529 \u001b[22m       <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"plan reveal\"\u001b[38;5;231m>\u001b[44G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 530 \u001b[22m         <h3>Free</h3>\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 531 \u001b[22m         <p \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"desc\"\u001b[38;5;231m>For side projects and trying Tideline out.</p>\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
