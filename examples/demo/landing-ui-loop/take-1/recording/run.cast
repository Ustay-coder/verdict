[325.3461, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 459 -\u001b[38;5;231m        <p>Before anyone gets paged, the failure has to be confirmed from at least\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231m three regions.</p>                                                               \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 458 +\u001b[38;5;231m        <h3>Alerts only when 2 regions agree</h3>                                 \r\u001b[5C\u001b[1B\u001b[38;5;77m 459 +\u001b[38;5;231m        <p>Before anyone gets \u001b[48;5;28malerted\u001b[48;5;22m, the failure has to be \u001b[48;5;28mseen\u001b[48;5;22m from at least \u001b[48;5;28m2\u001b[48;5;22m \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m     +\u001b[38;5;231m\u001b[48;5;28mof the 6 \u001b[48;5;22mregions.</p>                                                             \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;231m\u001b[2m 460 \u001b[22m         <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"verify\"\u001b[38;5;231m \u001b[38;5;148maria-hidden\u001b[38;5;231m=\u001b[38;5;186m\"true\"\u001b[38;5;231m>\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 461 -\u001b[38;5;231m          <div class=\"vrow\"><span class=\"chip fail\">Fail</span>fra-1 timeout<span \r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mclass=\"t\">03:12:04</span></div>                                                   \r\u001b[5C\u001b[1B\u001b[38;5;167m 462 -\u001b[38;5;231m          <div class=\"vrow\"><span class=\"chip ok\">Ok</span>iad-2 200<span class=\"t\r\u001b[6C\u001b[1B\u001b[38;5;167m   \u001b[12G\u001b[38;5;231m\">03:12:05</span></div>\u001b[36G  \u001b[39G        \u001b[48G     \u001b[54G  \u001b[57G            \r\u001b[7C\u001b[1B\u001b[38;5;167m63\u001b[20G\u001b[38;5;231m  <div class=\"vrow\"><span class=\"chip ok\">Ok</span>sin-1 200<span\u001b[86Gclass=\"t\r\u001b[11C\u001b[1B\">03:12:05</span></div>     \u001b[41G  \u001