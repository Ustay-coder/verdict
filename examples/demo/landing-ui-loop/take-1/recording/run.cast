[326.5087, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 458 +\u001b[38;5;231m        <h3>Alerts only when 2 regions agree</h3>                                 \r\u001b[5C\u001b[1B\u001b[38;5;77m 459 +\u001b[38;5;231m        <p>Before anyone gets \u001b[48;5;28malerted\u001b[48;5;22m, the failure has to be \u001b[48;5;28mseen\u001b[48;5;22m from at least \u001b[48;5;28m2\u001b[48;5;22m \r\u001b[6C\u001b[1B\u001b[38;5;77m   \u001b[12G\u001b[38;5;231m\u001b[48;5;28mof the 6 \u001b[48;5;22mregions.</p>  \u001b[36G    \u001b[41G \u001b[43G       \u001b[51G          \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 460 \u001b[22m         <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"verify\"\u001b[38;5;231m \u001b[38;5;148maria-hidden\u001b[38;5;231m=\u001b[38;5;186m\"true\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 461 -\u001b[38;5;231m          <div class=\"vrow\"><span class=\"chip fail\">Fail</span>fra-1 timeout<span \r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mclass=\"t\">03:12:04</span></div>                                                   \r\u001b[8C\u001b[1B\u001b[38;5;167m2\u001b[58G\u001b[38;5;231mok\">Ok</span>i\u001b[73Gd-2 200<span cla\u001b[90Gs=\"t\r\u001b[11C\u001b[1B\">03:12:05</span></div>        \r\u001b[8C\u001b[1B\u001b[38;5;167m3\u001b[71G\u001b[38;5;231msin\u001b[75G1\r\u001b[8C\u001b[2B\u001b[38;5;167m4\u001b[39G\u001b[38;5;231m style=\"border-style:dashed\"><span class=\"chip\u001b[86Ggo\">Held\r\u001b[11C\u001b[1B</span>Not paged, you slept<span\u001b[45Gclass=\"t\">\u2713</span></div>\r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 461 +\u001b[38;5;231m          <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"vrow\"\u001b[38;5;231m><span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"chip fail\"\u001b[38;5;231m>Fail</span>fra timeout</div>  \r\u001b[5C\u001b[1B\u001b[38;5;77m 462 +\u001b[38;5;231m          <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"vrow\"\u001b[38;5;231m><span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"chip ok\"\u001b[38;5;231m>Ok</span>iad</div>              \r\u001b[8C\u001b[1B\u001b[38;5;77m3\u001b[58G\u001b[38;5;186mok\"\u001b[38;5;231m>Ok</span>si\u001b[74G</div>            \r\u001b[8C\u001b[1B\u001b[38;5;77m4\u001b[39G\u001b[38;5;231m \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"border-style:dashed\"\u001b[38;5;231m><span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"chip go\"\u001b[38;5;231m>Held\r\u001b[6C\u001b[1B\u001b[38;5;77m   \u001b[12G\u001b[38;5;231m</span>Not \u001b[48;5;28malerted:\u001b[48;5;22m \u001b[48;5;28monly\u001b[48;5;22m \u001b[48;5;28mone\u001b[48;5;22m \u001b[48;5;28mregion failed\u001b[48;5;22m</div>                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 465 \u001b[22m         </div>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 466 \u001b[22m       </article>\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;5;231m\u001b[2m7\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
