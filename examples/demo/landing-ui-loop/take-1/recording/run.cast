[321.4958, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 430 +\u001b[38;5;231m      <p>Built for teams of 2 to 20 engineers who run their own services, and quie\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231mt unless something is genuinely wrong.</p>                                        \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 431 \u001b[22m     </div>\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 432 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 433 \u001b[22m     <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"bento\"\u001b[38;5;231m>\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[39m \u001b[1mUpdate\u001b[22m(index.html)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m 432 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 433 \u001b[22m     <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"bento\"\u001b[38;5;231m>\r\u001b[7C\u001b[1B\u001b[2m34\u001b[14G\u001b[22m    <article \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"tile xwide reveal\"\u001b[38;5;231m>\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 435 -\u001b[38;5;231m        <h3>Checks from 12 regions, every 30 seconds</h3>                         \r\u001b[5C\u001b[1B\u001b[38;5;167m 436 -\u001b[38;5;231m        <p>HTTP, TCP, ping, DNS, and keyword checks from four continents. You find\r\u001b[6C\u001b[1B\u001b[38;5;167m   \u001b[13G\u001b[38;5;231mout\u001b[17Gabout a\u001b[25Gregion\u001b[32Gl outag\u001b[40G in Singapore even\u001b[59Gwh\u001b[62Gn your laptop in Oh\u001b[82Go says every\r\u001b[11C\u001b[1Bthing's fine.</p>   \u001b[33G  \u001b[36G         \u001b[46G          \r\u001b[8C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m5\u001b[18G\u001b[38;5;231m  <h3>Checks\u001b[31Gfro\u001b[35G \u001b[48;5;28m6\u001b[48;5;22m regions, every 30 \u001b[57Geconds</h3>   \u001b[72G   \u001b[76G         \u001b[86G   \u001b[90G    \r\u001b[6C\u001b[1B\u001b[38;5;77m436\u001b[12G\u001b[38;5;231m \u001b[14G      <p>\u001b[48;5;28mEvery\u001b[48;5;22m \u001b[48;5;28mmonitor\u001b[48;5;22m \u001b[48;5;28mis\u001b[48;5;22m \u001b[48;5;28mchecked\u001b[48;5;22m from \u001b[48;5;28m6\u001b[55Gregions\u001b[48;5;22m.\u001b[64GYou\u001b[68Gfind\u001b[73Gout\u001b[77Gabout\u001b[83Ga\u001b[85Gregional\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231moutage in Singapore even when your laptop in Ohio says everything's fine.</p>     \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m7\u001b[12G\u001b[22m        <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"map\"\u001b[38;5;231m \u001b[38;5;148maria-hidden\u001b[38;5;231m=\u001b[38;5;186m\"true\"\u001b[38;5;231m>\r\u001b[8C\u001b[1B\u001b[2m8\u001b[16G\u001b[22m    \u001b[21G <svg \u001b[38;5;148mviewBox\u001b[38;5;231m=\u001b[38;5;186m\"0 0 600 190\"\u001b[38;5;231m \u001b[38;5;148mpreserveAspectRatio\u001b[38;5;231m=\u001b[38;5;186m\"xMidYMid meet\"\u001b[38;5;231m \u001b[38;5;148mid\u001b[38;5;231m=\u001b[38;5;186m\"mapSv\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m     \u001b[22m \u001b[38;5;186mg\"\u001b[38;5;231m>\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 439 \u001b[22m             <defs>\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
