=\"grad-te\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mxt\">Be the first to know.</span></h2>                                             \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 629 +\u001b[38;5;231m      <h2 \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"margin-top:14px\"\u001b[38;5;231m>Your next outage is coming. Be the first to know\r\u001b[5C\u001b[1B\u001b[38;5;77m     +\u001b[38;5;231m.</h2>                                                                            \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m30\u001b[19G\u001b[22mp>Yo\u001b[24Gr f\u001b[28Grst 10 monitors are free forever. Upgrade when your team needs mor\r\u001b[6C\u001b[1B\u001b[2m   \u001b[12G\u001b[22me.</p>\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m31\u001b[16G\u001b[22m  <form \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"signup\"\u001b[38;5;231m \u001b[38;5;148mid\u001b[38;5;231m=\u001b[38;5;186m\"signup\"\u001b[38;5;231m \u001b[38;5;148mnovalidate\u001b[38;5;231m>\r\u001b[5C\u001b[1B\u001b[2m 632 \u001b[22m         <label \u001b[38;5;148mfor\u001b[38;5;231m=\u001b[38;5;186m\"email\"\u001b[38;5;231m \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"position:absolute;width:1px;height:1px;overflow:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m     \u001b[22m \u001b[38;5;186mhidden;clip:rect(0 0 0 0)\"\u001b[38;5;231m>Work email</label>\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
