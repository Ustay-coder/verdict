[328.6648, "o", "\u001b[?25l\u001b[H\u001b[9G\u001b[38;5;77m\u001b[48;5;22m4\u001b[39G\u001b[38;5;231m \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"border-style:dashed\"\u001b[38;5;231m><span \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"chip go\"\u001b[38;5;231m>Held\r\u001b[6C\u001b[1B\u001b[38;5;77m   \u001b[12G\u001b[38;5;231m</span>Not \u001b[48;5;28malerted:\u001b[48;5;22m \u001b[48;5;28monly\u001b[48;5;22m \u001b[48;5;28mone\u001b[48;5;22m \u001b[48;5;28mregion failed\u001b[48;5;22m</div>                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 465 \u001b[22m         </div>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 466 \u001b[22m       </article>\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;5;231m\u001b[2m7\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;5;231m\u001b[2m 467 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;5;231m\u001b[2m 468 \u001b[22m       <article \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"tile reveal\"\u001b[38;5;231m>\r\u001b[8C\u001b[1B\u001b[2m9\u001b[12G\u001b[22m        <h3>Status pages people trust</h3>\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 470 -\u001b[38;5;231m        <p>A branded status page on status.yourco.com that updates itself, with su\r\u001b[5C\u001b[1B\u001b[38;5;167m     -\u001b[38;5;231mbscriber emails included.</p>                                                     \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 470 +\u001b[38;5;231m        <p>One public status page per project, on your own domain.</p>            \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 471 \u001b[22m         <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5