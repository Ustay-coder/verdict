[319.6721, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186mCpath d='M5 19c3.5 0 3.5-4 7-4s3.5 4 7 4 3.5-4 7-4' stroke='%2322e5c8' stroke-width\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m    \u001b[22m \u001b[38;5;186m='3' fill='none' stroke-linecap='round'/%3E%3C/svg%3E\"\u001b[38;5;231m>\r\u001b[7C\u001b[1B\u001b[2m9\u001b[12G\u001b[22mstyle>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m10\u001b[11G\u001b[22m:root{\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mNow the features section:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39mReading \u001b[1m1\u001b[22m file\u2026\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf  index.html\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;114m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m427 \u001b[22m   <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"wrap\"\u001b[38;5;231m>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m428 \u001b[22m     <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"sec-head reveal\"\u001b[38;5;231m>\r\u001b[6C\u001b[1B\u001b[2m429 \u001b[22m       <h2>Monitoring without the enterprise overhead.</h2>\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 430 -\u001b[38;5;231m      <p>The tools a five-person team actually needs, configured in minutes and qu\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m     -\u001b[38;5;231miet unless something is genuinely wrong.</p>                                      \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 430 +\u001b[38;5;231m      <p>Built for teams of 2 to 20 engineers who run their own services, and quie\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;5;77m\u001b[48;5;22m     +\u001b[38;5;231mt unless something is genuinely wrong.</p>                                        \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;231m\u001b[2m 431 \u001b[22m     </div>\r\u001b[5C\u001b[1B\u001b[2m 432 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;5;231m\u001b[2m 433 \u001b[22m     <div \u001b[38;5;148mclass\u001b[38;5;231m=\u001b[38;5;186m\"bento\"\u001b[38;5;231m>\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
