001b[38;5;231m          <span><i \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"background:#22e5c8\"\u001b[38;5;231m></i>SMS</span>                      \r\u001b[5C\u001b[1B\u001b[38;5;77m 494 +\u001b[38;5;231m          <span><i \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"background:#34d399\"\u001b[38;5;231m></i>PagerDuty</span>                \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 495 \u001b[22m           <span><i \u001b[38;5;148mstyle\u001b[38;5;231m=\u001b[38;5;186m\"background:#fbbf24\"\u001b[38;5;231m></i>Webhooks</span>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 496 -\u001b[38;5;231m          <span><i style=\"background:#8b5cf6\"></i>Teams</span>                    \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m6\u001b[20G\u001b[22m</div>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 497 \u001b[22m       </article>\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;5;231m\u001b[2m8\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(index.html)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
